    protected override async Task OnInitializedAsync()
    {
        Console.WriteLine("=== [CLIENT DEBUG] OnInitializedAsync Started ===");

        if (!authService.IsInitialized)
            await authService.InitializeAsync();

        Console.WriteLine($"[CLIENT DEBUG] IsLoggedIn: {authService.IsLoggedIn}");
        Console.WriteLine($"[CLIENT DEBUG] Roles: {string.Join(", ", authService.Roles)}");
        Console.WriteLine($"[CLIENT DEBUG] Token Length: {authService.AccessToken?.Length ?? 0}");

        if (!authService.IsLoggedIn || !authService.Roles.Contains("Admin"))
        {
            Console.WriteLine("[CLIENT DEBUG] Access Denied -> Redirecting to /login");
            Nav.NavigateTo("login");
            return;
        }

        if (!string.IsNullOrEmpty(authService.AccessToken))
        {
            Http.DefaultRequestHeaders.Authorization = 
                new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", authService.AccessToken);
                
            Console.WriteLine($"[CLIENT DEBUG] Attached Bearer Token to HttpClient Headers.");
        }
        else
        {
            Console.WriteLine("[CLIENT DEBUG] WARNING: AccessToken is null or empty!");
        }

        await LoadTeams();
        await SetupSignalRHub();
    }
    private async Task SetupSignalRHub()
    {
        teamHubConnection = new HubConnectionBuilder()
            .WithUrl(Nav.ToAbsoluteUri("/teamhub") ,options =>{
                options.AccessTokenProvider = () => Task.FromResult(authService.AccessToken);
            })
            .WithAutomaticReconnect()
            .Build();

        // ⚡ SignalR Listeners for Real-time Full CRUD Sync
        teamHubConnection.On<TeamDto>("ReceiveTeamAdded", (addedTeam) =>
        {
            if (!RegisteredTeams.Any(t => t.Id == addedTeam.Id))
            {
                RegisteredTeams.Add(addedTeam);
                InvokeAsync(StateHasChanged);
            }
        });

        teamHubConnection.On<TeamDto>("ReceiveTeamUpdated", (updatedTeam) =>
        {
            var existing = RegisteredTeams.FirstOrDefault(t => t.Id == updatedTeam.Id);
            if (existing != null)
            {
                existing.Name = updatedTeam.Name;
                existing.Record = updatedTeam.Record;
                if (updatedTeam.Logo != null && updatedTeam.Logo.Length > 0)
                {
                    existing.Logo = updatedTeam.Logo;
                }
                InvokeAsync(StateHasChanged);
            }
        });

        teamHubConnection.On<Guid>("ReceiveTeamDeleted", (deletedTeamId) =>
        {
            RegisteredTeams.RemoveAll(t => t.Id == deletedTeamId);
            if (editingTeamId == deletedTeamId)
            {
                CancelEdit();
            }
            InvokeAsync(StateHasChanged);
        });

        try
        {
            await teamHubConnection.StartAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"TeamHub error: {ex.Message}");
        }
    }

    private async Task LoadTeams()
    {
        isLoadingList = true;
        try
        {
            var teams = await Http.GetFromJsonAsync<List<TeamDto>>("api/team");
            if (teams != null)
            {
                RegisteredTeams = teams;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load teams: {ex.Message}";
        }
        finally
        {
            isLoadingList = false;
        }
    }

    private void EditTeam(TeamDto team)
    {
        editingTeamId = team.Id;
        teamModel = new TeamDto
        {
            Id = team.Id,
            Name = team.Name,
            Record = team.Record,
            Logo = team.Logo
        };

        if (team.Logo != null && team.Logo.Length > 0)
        {
            logoPreviewUrl = GetImageSrc(team.Logo);
        }
        else
        {
            logoPreviewUrl = null;
        }

        errorMessage = string.Empty;
        successMessage = string.Empty;
    }

    private void CancelEdit()
    {
        editingTeamId = null;
        teamModel = new TeamDto();
        logoPreviewUrl = null;
        errorMessage = string.Empty;
    }

    private async Task HandleLogoSelected(InputFileChangeEventArgs e)
    {
        errorMessage = string.Empty;
        var file = e.File;

        if (file != null)
        {
            if (file.Size > 2 * 1024 * 1024)
            {
                errorMessage = "File size exceeds 2MB limit.";
                return;
            }

            try
            {
                var format = file.ContentType;
                using var ms = new MemoryStream();

                // 🎨 Check if the file is an SVG vector
                bool isSvg = format == "image/svg+xml" || file.Name.EndsWith(".svg", StringComparison.OrdinalIgnoreCase);

                if (isSvg)
                {
                    // Stream raw SVG vector directly without resizing
                    using var stream = file.OpenReadStream(maxAllowedSize: 2 * 1024 * 1024);
                    await stream.CopyToAsync(ms);
                    format = "image/svg+xml";
                }
                else
                {
                    // Resample raster images (PNG, JPG, WEBP)
                    var resizedImage = await file.RequestImageFileAsync(format, 300, 300);
                    using var stream = resizedImage.OpenReadStream(maxAllowedSize: 2 * 1024 * 1024);
                    await stream.CopyToAsync(ms);
                }

                teamModel.Logo = ms.ToArray();
                logoPreviewUrl = $"data:{format};base64,{Convert.ToBase64String(teamModel.Logo)}";
            }
            catch (Exception ex)
            {
                errorMessage = $"Error processing image: {ex.Message}";
            }
        }
    }

    private async Task HandleSaveTeam()
    {
        successMessage = string.Empty;
        errorMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(teamModel.Name))
        {
            errorMessage = "Please enter a valid team name.";
            return;
        }

        isSubmitting = true;

        try
        {
            HttpResponseMessage response;

            if (isEditing)
            {
                // ✏️ UPDATE existing team (PUT api/team/{id})
                response = await Http.PutAsJsonAsync($"api/team/{editingTeamId}", teamModel);
            }
            else
            {
                // 🚀 CREATE new team (POST api/team)
                if (teamModel.Logo == null || teamModel.Logo.Length == 0)
                {
                    errorMessage = "Please upload a team logo.";
                    isSubmitting = false;
                    return;
                }
                response = await Http.PostAsJsonAsync("api/team", teamModel);
            }

            if (response.IsSuccessStatusCode)
            {
                successMessage = isEditing 
                    ? $"Team '{teamModel.Name}' updated successfully!" 
                    : $"Team '{teamModel.Name}' registered successfully!";

                CancelEdit();
            }
            else
            {
                var details = await response.Content.ReadAsStringAsync();
                errorMessage = $"Failed to save team. ({response.StatusCode}) {details}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Network error: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task DeleteTeam(Guid teamId)
    {
        errorMessage = string.Empty;
        successMessage = string.Empty;

        try
        {
            var response = await Http.DeleteAsync($"api/team/{teamId}");
            if (response.IsSuccessStatusCode)
            {
                successMessage = "Team removed successfully.";
            }
            else
            {
                errorMessage = "Could not delete team.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error deleting team: {ex.Message}";
        }
    }

    private string GetImageSrc(byte[]? imageBytes)
    {
        if (imageBytes == null || imageBytes.Length == 0)
            return "images/default-logo.png";

        string base64 = Convert.ToBase64String(imageBytes);

        // 🔍 Detect SVG magic header bytes: '<svg' (0x3C, 0x73, 0x76, 0x67)
        if (imageBytes.Length >= 4 && 
            imageBytes[0] == 0x3C && imageBytes[1] == 0x73 && 
            imageBytes[2] == 0x76 && imageBytes[3] == 0x67)
        {
            return $"data:image/svg+xml;base64,{base64}";
        }

        return $"data:image/png;base64,{base64}";
    }

    private void GoToDashboard()
    {
        Nav.NavigateTo("/dashboard");
    }

    public async ValueTask DisposeAsync()
    {
        if (teamHubConnection is not null)
        {
            await teamHubConnection.DisposeAsync();
        }
    }
}