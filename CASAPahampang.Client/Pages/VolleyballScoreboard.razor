@page "/volleyball-scoreboard"

@using Microsoft.AspNetCore.SignalR.Client
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@using System.Text.Json
@using CASAPahampang.Client.Dtos
@implements IAsyncDisposable
@rendermode InteractiveWebAssembly
@inject NavigationManager Navigation
@inject HttpClient Http

<div class="fan-scoreboard-container volleyball-theme w-100 container-fluid px-2 px-md-3 py-3" style="max-width: 100% !important;">
    <header class="scoreboard-header w-100 d-flex flex-column flex-md-row align-items-center justify-content-between gap-3 mb-3">
        <button class="btn-back" @onclick="GoBack" type="button">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg>
            Dashboard
        </button>

        <div class="tournament-title text-center">
            <p class="branding-sub">CENTRAL AZUCARERA DE SAN ANTONIO</p>
            <h1>CASA PAHAMPANG VOLLEYBALL 🏐⚡</h1>
            <p class="venue-tag">📍 Main Gymnasium • Court 2</p>
        </div>

        <div class="live-status-badge @(IsLive ? "is-live" : "is-paused")">
            <span class="status-dot"></span>
            @(IsLive ? "LIVE" : "STANDBY")
        </div>
    </header>

    @if (IsConnecting)
    {
        <div class="standby-overlay text-center p-5 w-100">
            <div class="spinner-border text-info" role="status"></div>
            <p class="mt-3 fs-4 text-white">Connecting to volleyball broadcast... 📡🏐</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="standby-banner text-center my-3 p-4 rounded bg-dark text-danger border border-danger w-100">
            ❌ <strong>Connection Error:</strong> @ErrorMessage
            <div class="mt-3">
                <button class="btn btn-warning font-weight-bold" @onclick="InitializeConnection">
                    🔄 Retry Connection
                </button>
            </div>
        </div>
    }
    else if (!IsLive)
    {
        <div class="standby-banner text-center my-3 p-3 rounded bg-dark text-warning border border-warning w-100">
            ⏳ <strong>MATCH STANDBY:</strong> Waiting for scorekeeper to activate live broadcast.
        </div>
    }

    <div class="arena-board @(!IsLive ? "dimmed-board" : "") d-flex flex-column flex-lg-row w-100 gap-3 align-items-stretch">
        <div class="team-card team-home @(ServingTeam == 1 ? "is-serving" : "")" style="order: @(IsSidesSwitched ? 3 : 1); flex: 1; min-width: 0;">
            <div class="team-meta">
                @if (!string.IsNullOrWhiteSpace(Team1LogoUrl))
                {
                    <img src="@Team1LogoUrl" alt="@Team1Name Logo" class="team-logo" />
                }
                <h2 class="team-name">@(string.IsNullOrWhiteSpace(Team1Name) ? "HOME" : Team1Name)</h2>
                <div class="team-indicators">
                    @if (ServingTeam == 1)
                    {
                        <span class="serving-pill">🏐 SERVING</span>
                    }
                </div>
            </div>

            <div class="sets-won-tag">
                SETS WON: <strong>@Team1SetsWon</strong>
            </div>

            <div class="led-score-box">
                <span class="led-score">@Team1CurrentSetScore</span>
            </div>

            <div class="stats-row">
                <div class="stat-pill">
                    <span class="lbl">TIMEOUTS</span>
                    <span class="val">@Team1Timeouts / 2</span>
                </div>
                <div class="stat-pill">
                    <span class="lbl">SUBS</span>
                    <span class="val">@Team1Subs / 6</span>
                </div>
            </div>
        </div>

        <div class="center-clock-panel" style="order: 2; flex: 0 0 auto; min-width: 0; width: 100%;">
            <div class="period-badge">
                <span>SET @CurrentSetNumber</span>
            </div>

            <div class="match-format-info my-2 text-center text-light">
                <small class="text-uppercase fw-bold text-warning">Best of 5 • First to 25 pts</small>
            </div>

            <div class="set-history-summary mt-3 w-100">
                <h5 class="text-center text-light border-bottom border-secondary pb-1 fs-6">SET HISTORY</h5>
                @if (CompletedSets.Count == 0)
                {
                    <p class="text-center text-muted small my-2">No sets completed yet.</p>
                }
                else
                {
                    <div class="d-flex flex-column gap-1">
                        @foreach (var set in CompletedSets)
                        {
                            <div class="d-flex justify-content-between px-3 py-1 bg-dark rounded border border-secondary fs-7 text-light">
                                <span>Set @set.SetNumber:</span>
                                <strong>
                                    <span class="@(set.Team1Score > set.Team2Score ? "text-warning" : "")">@set.Team1Score</span>
                                    -
                                    <span class="@(set.Team2Score > set.Team1Score ? "text-warning" : "")">@set.Team2Score</span>
                                </strong>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="team-card team-away @(ServingTeam == 2 ? "is-serving" : "")" style="order: @(IsSidesSwitched ? 1 : 3); flex: 1; min-width: 0;">
            <div class="team-meta">
                @if (!string.IsNullOrWhiteSpace(Team2LogoUrl))
                {
                    <img src="@Team2LogoUrl" alt="@Team2Name Logo" class="team-logo" />
                }
                <h2 class="team-name">@(string.IsNullOrWhiteSpace(Team2Name) ? "AWAY" : Team2Name)</h2>
                <div class="team-indicators">
                    @if (ServingTeam == 2)
                    {
                        <span class="serving-pill">🏐 SERVING</span>
                    }
                </div>
            </div>

            <div class="sets-won-tag">
                SETS WON: <strong>@Team2SetsWon</strong>
            </div>

            <div class="led-score-box">
                <span class="led-score">@Team2CurrentSetScore</span>
            </div>

            <div class="stats-row">
                <div class="stat-pill">
                    <span class="lbl">TIMEOUTS</span>
                    <span class="val">@Team2Timeouts / 2</span>
                </div>
                <div class="stat-pill">
                    <span class="lbl">SUBS</span>
                    <span class="val">@Team2Subs / 6</span>
                </div>
            </div>
        </div>
    </div>

    <div class="ticker-section w-100 mt-3">
        <div class="ticker-header">
            <span>🔥 MATCH LOG</span>
        </div>
        <div class="ticker-content">
            @if (RecentEvents.Count == 0)
            {
                <div class="ticker-item empty">Waiting for match actions...</div>
            }
            else
            {
                <div class="ticker-list">
                    @foreach (var evtMsg in RecentEvents.Take(5))
                    {
                        <div class="ticker-item">
                            <span class="evt-text">@evtMsg</span>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>


@code {
    public class CompletedSetRecord
    {
        public int SetNumber { get; set; }
        public int Team1Score { get; set; }
        public int Team2Score { get; set; }
    }

    public class VolleyballStatePayload
    {
        public string Sport { get; set; } = string.Empty;
        public string Team1Name { get; set; } = string.Empty;
        public string Team1LogoUrl { get; set; } = string.Empty;
        public int Team1Score { get; set; }
        public int Team1CurrentSetScore { get; set; }
        public int Team1SetsWon { get; set; }
        public int Team1Timeouts { get; set; }
        public int Team1Subs { get; set; }

        public string Team2Name { get; set; } = string.Empty;
        public string Team2LogoUrl { get; set; } = string.Empty;
        public int Team2Score { get; set; }
        public int Team2CurrentSetScore { get; set; }
        public int Team2SetsWon { get; set; }
        public int Team2Timeouts { get; set; }
        public int Team2Subs { get; set; }

        public int ServingTeam { get; set; } = 1;
        public int CurrentSetNumber { get; set; } = 1;
        public bool IsSidesSwitched { get; set; } = false; // 👈 Visual state received via payload
        public List<CompletedSetRecord> CompletedSets { get; set; } = new();
        public bool IsLive { get; set; }
        public string StatusText { get; set; } = string.Empty;
        public List<string> RecentEvents { get; set; } = new();
    }

    private HubConnection? hubConnection;

    private bool IsConnecting = true;
    private string ErrorMessage = string.Empty;
    private bool IsLive = false;

    private string Team1Name = string.Empty;
    private string Team1LogoUrl = string.Empty;
    private int Team1CurrentSetScore = 0;
    private int Team1SetsWon = 0;
    private int Team1Timeouts = 0;
    private int Team1Subs = 0;

    private string Team2Name = string.Empty;
    private string Team2LogoUrl = string.Empty;
    private int Team2CurrentSetScore = 0;
    private int Team2SetsWon = 0;
    private int Team2Timeouts = 0;
    private int Team2Subs = 0;

    private int ServingTeam = 1;
    private int CurrentSetNumber = 1;
    private bool IsSidesSwitched = false;
    private List<CompletedSetRecord> CompletedSets = new();
    private List<string> RecentEvents = new();

    private static readonly JsonSerializerOptions JsonOptions = new()
    {
        PropertyNameCaseInsensitive = true
    };

    protected override async Task OnInitializedAsync()
    {
        await InitializeConnection();
    }

    private async Task InitializeConnection()
    {
        IsConnecting = true;
        ErrorMessage = string.Empty;

        await LoadStateFromDatabaseAsync();
        await ConnectToHubAsync();
    }

    private async Task LoadStateFromDatabaseAsync()
    {
        try
        {
            var allMatches = await Http.GetFromJsonAsync<List<MatchDto>>(Navigation.ToAbsoluteUri("api/matches")) ?? new();
            var activeMatch = allMatches.FirstOrDefault(m => string.Equals(m.Sport, "Volleyball", StringComparison.OrdinalIgnoreCase) && m.IsLive)
                           ?? allMatches.FirstOrDefault(m => string.Equals(m.Sport, "Volleyball", StringComparison.OrdinalIgnoreCase) && !string.Equals(m.StatusText, "Concluded", StringComparison.OrdinalIgnoreCase));

            if (activeMatch != null)
            {
                Team1Name = activeMatch.Team1?.Name ?? "TBD";
                Team1LogoUrl = GetImageSrc(activeMatch.Team1?.Logo);
                Team1SetsWon = activeMatch.Team1Score;

                Team2Name = activeMatch.Team2?.Name ?? "TBD";
                Team2LogoUrl = GetImageSrc(activeMatch.Team2?.Logo);
                Team2SetsWon = activeMatch.Team2Score;

                IsLive = activeMatch.IsLive;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"DB Initial Load Warning (Volleyball): {ex.Message}");
        }
        finally
        {
            IsConnecting = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ConnectToHubAsync()
    {
        try
        {
            if (hubConnection is not null)
            {
                await hubConnection.DisposeAsync();
            }

            hubConnection = new HubConnectionBuilder()
                .WithUrl(Navigation.ToAbsoluteUri("/sportshub"))
                .WithAutomaticReconnect()
                .Build();

            Action<string> handleStateJson = (json) =>
            {
                try
                {
                    var data = JsonSerializer.Deserialize<VolleyballStatePayload>(json, JsonOptions);
                    if (data is not null && string.Equals(data.Sport, "Volleyball", StringComparison.OrdinalIgnoreCase))
                    {
                        IsConnecting = false;
                        IsLive = data.IsLive;

                        Team1Name = data.Team1Name;
                        Team1LogoUrl = data.Team1LogoUrl;
                        Team1CurrentSetScore = data.Team1CurrentSetScore;
                        Team1SetsWon = data.Team1SetsWon;
                        Team1Timeouts = data.Team1Timeouts;
                        Team1Subs = data.Team1Subs;

                        Team2Name = data.Team2Name;
                        Team2LogoUrl = data.Team2LogoUrl;
                        Team2CurrentSetScore = data.Team2CurrentSetScore;
                        Team2SetsWon = data.Team2SetsWon;
                        Team2Timeouts = data.Team2Timeouts;
                        Team2Subs = data.Team2Subs;

                        ServingTeam = data.ServingTeam;
                        CurrentSetNumber = data.CurrentSetNumber;
                        IsSidesSwitched = data.IsSidesSwitched;
                        CompletedSets = data.CompletedSets ?? new();
                        RecentEvents = data.RecentEvents ?? new();

                        InvokeAsync(StateHasChanged);
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error parsing Volleyball MatchState payload: {ex.Message}");
                }
            };

            hubConnection.On<string>("SendMatchState", handleStateJson);
            hubConnection.On<string>("ReceiveMatchState", handleStateJson);

            await hubConnection.StartAsync();

            if (hubConnection.State == HubConnectionState.Connected)
            {
                IsConnecting = false;
                await hubConnection.SendAsync("RequestStateFromHost", "Volleyball");
            }
        }
        catch (Exception ex)
        {
            IsConnecting = false;
            Console.WriteLine($"Volleyball SignalR Connection Exception: {ex.Message}");
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private string GetImageSrc(byte[]? imageBytes)
    {
        if (imageBytes == null || imageBytes.Length == 0)
            return "images/default-logo.png";

        string base64 = Convert.ToBase64String(imageBytes);
        int headerLength = Math.Min(imageBytes.Length, 100);
        string headerText = System.Text.Encoding.UTF8.GetString(imageBytes, 0, headerLength);

        if (headerText.Contains("<svg", StringComparison.OrdinalIgnoreCase))
        {
            return $"data:image/svg+xml;base64,{base64}";
        }

        return $"data:image/png;base64,{base64}";
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/dashboard");
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}