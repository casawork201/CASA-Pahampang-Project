@page "/scorekeeper"

@using Microsoft.AspNetCore.SignalR.Client
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@using System.Timers
@using System.Text.Json
@using System.Net.Http.Json
@using CASAPahampang.Client.Dtos
@implements IAsyncDisposable
@rendermode InteractiveWebAssembly
@inject NavigationManager Navigation
@inject HttpClient Http
@inject IJSRuntime JS

<div class="scorekeeper-container w-100 container-fluid px-2 px-md-3 py-3" style="max-width: 100% !important;">
    <header class="dashboard-header d-flex flex-column flex-md-row justify-content-between align-items-stretch align-items-md-center gap-3">
        <div class="header-left d-flex flex-column flex-sm-row align-items-start align-items-sm-center gap-2 gap-sm-3">
            <button class="btn-back" @onclick="GoBack" type="button">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg>
                Back to Dashboard
            </button>
            <div class="header-title">
                <p class="branding-subtitle">CENTRAL AZUCARERA DE SAN ANTONIO</p>
                <h1>BASKETBALL SCOREKEEPER CONSOLE ⚡🏀</h1>
            </div>
        </div>
        <div class="live-badge align-self-start align-self-md-center">
            <span class="pulse-dot"></span> LIVE SCORING IN PROGRESS 🔴
        </div>
    </header>

    <div class="match-selector-card mb-4 p-3 rounded w-100" style="background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.15);">
        <div class="row align-items-center w-100 m-0">
            <div class="col-md-7 col-12 mb-2 mb-md-0 px-0">
                <label class="form-label text-light fw-bold small text-uppercase mb-1">
                    🏀 Select Active Match (Excludes "Concluded" Matches)
                </label>
                <select class="form-select form-select-lg bg-dark text-light border-secondary w-100" @onchange="OnMatchSelected">
                    <option value="">-- Choose a Match to Score --</option>
                    @foreach (var match in AvailableMatches)
                    {
                        <option value="@match.Id" selected="@(SelectedMatch?.Id == match.Id)">
                            GAME @match.GameNumber: @(match.Team1?.Name ?? "TBD") vs @(match.Team2?.Name ?? "TBD") | @match.Venue (@(string.IsNullOrWhiteSpace(match.StatusText) ? "Scheduled" : match.StatusText))
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-5 col-12 text-md-end text-start d-flex align-items-center justify-content-md-end gap-2 mt-2 mt-md-0 px-0">
                @if (SelectedMatch != null)
                {
                    <span class="badge bg-success px-3 py-2">
                        Active: GAME @SelectedMatch.GameNumber (@SelectedMatch.Sport) 🏆
                    </span>
                    <button class="btn btn-danger btn-sm px-3 py-2 fw-bold" @onclick="ConcludeMatchAsync" title="Mark match as Concluded">
                        🏁 Conclude Match
                    </button>
                }
                else
                {
                    <span class="badge bg-warning text-dark px-3 py-2">
                        ⚠️ Please Select a Match
                    </span>
                }
            </div>
        </div>
    </div>

    @if (SelectedMatch == null)
    {
        <div class="alert alert-info text-center py-5 rounded my-4 w-100">
            <h4>No Active Match Selected 🏀</h4>
            <p class="mb-0">Please select an ongoing or upcoming match from the dropdown above to begin scoring.</p>
        </div>
    }
    else
    {
        <div class="scoreboard-main d-flex flex-column flex-lg-row w-100 gap-3 align-items-stretch">
            <div class="team-panel team-panel-left flex-fill" style="order: 1; min-width: 0;">
                <div class="team-header">
                    <img src="@Team1LogoUrl" alt="@Team1Name Logo" class="team-logo-lg" />
                    <h2>@Team1Name</h2>
                </div>

                <div class="possession-toggle">
                    <button class="btn-poss @(Team1Possession ? "active" : "")" @onclick="() => TogglePossession(1)">
                        ◄ POSSESSION
                    </button>
                </div>
                
                <div class="big-score-display">
                    @Team1Score
                </div>

                <div class="score-controls">
                    <button class="btn-score btn-add" @onclick="() => ChangeScore(1, 1)">+1 ➕</button>
                    <button class="btn-score btn-add" @onclick="() => ChangeScore(1, 2)">+2 ➕</button>
                    <button class="btn-score btn-add" @onclick="() => ChangeScore(1, 3)">+3 ➕</button>
                    <button class="btn-score btn-sub" @onclick="() => ChangeScore(1, -1)">-1 ➖</button>
                </div>

                <div class="team-extra-controls">
                    <div class="stat-box">
                        <span>TIMEOUTS ⏱️</span>
                        <div class="stat-counter">
                            <button @onclick="() => ChangeTimeouts(1, -1)">-</button>
                            <strong>@Team1Timeouts</strong>
                            <button @onclick="() => ChangeTimeouts(1, 1)">+</button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="center-console flex-shrink-0" style="order: 2; width: 100%;">
                <div class="period-box">
                    <button class="btn-period" @onclick="PreviousPeriod">◀</button>
                    <span class="period-text">@PeriodText 📊</span>
                    <button class="btn-period" @onclick="NextPeriod">▶</button>
                </div>

                <div class="clock-card">
                    <span class="clock-label">GAME CLOCK ⏱️</span>

                    @if (isEditingClock)
                    {
                        <div class="d-flex align-items-center justify-content-center gap-1 my-2">
                            <input type="number" class="form-control form-control-sm bg-dark text-light text-center" style="width: 70px;" @bind="editMinutes" min="0" max="99" />
                            <span class="text-light fw-bold">:</span>
                            <input type="number" class="form-control form-control-sm bg-dark text-light text-center" style="width: 70px;" @bind="editSeconds" min="0" max="59" />
                            <button class="btn btn-sm btn-success px-2" @onclick="SaveEditedClock">✓</button>
                            <button class="btn btn-sm btn-secondary px-2" @onclick="() => isEditingClock = false">✕</button>
                        </div>
                    }
                    else
                    {
                        <div class="digital-clock @(IsGameClockRunning ? "running" : "paused")" @onclick="EnableClockEdit" style="cursor: pointer;" title="Click to manually edit clock">
                            @FormatTime(GameClockSeconds)
                        </div>
                    }

                    <div class="clock-actions">
                        <button class="btn-clock @(IsGameClockRunning ? "btn-pause" : "btn-start")" @onclick="ToggleGameClock">
                            @(IsGameClockRunning ? "⏸ PAUSE" : "▶ START")
                        </button>
                        <button class="btn-clock btn-reset" @onclick="ResetGameClock">🔄 Reset (@DefaultQuarterMinutes:00)</button>
                    </div>

                    <div class="quarter-presets mt-2 d-flex align-items-center justify-content-center gap-1 flex-wrap">
                        <small class="text-muted me-1">Qtr Length:</small>
                        <button class="btn btn-sm btn-outline-secondary py-0 px-2 @(DefaultQuarterMinutes == 10 ? "active text-warning fw-bold" : "")" @onclick="() => SetDefaultQuarterMinutes(10)">10m</button>
                        <button class="btn btn-sm btn-outline-secondary py-0 px-2 @(DefaultQuarterMinutes == 8 ? "active text-warning fw-bold" : "")" @onclick="() => SetDefaultQuarterMinutes(8)">8m</button>
                        <button class="btn btn-sm btn-outline-secondary py-0 px-2 @(DefaultQuarterMinutes == 7 ? "active text-warning fw-bold" : "")" @onclick="() => SetDefaultQuarterMinutes(7)">7m</button>
                        <button class="btn btn-sm btn-outline-secondary py-0 px-2 @(DefaultQuarterMinutes == 5 ? "active text-warning fw-bold" : "")" @onclick="() => SetDefaultQuarterMinutes(5)">5m</button>
                    </div>
                </div>

                <div class="shot-clock-card @(ShotClockSeconds <= 5 && ShotClockSeconds > 0 ? "warning" : "") @(ShotClockSeconds == 0 ? "violation" : "")">
                    <span class="clock-label">SHOT CLOCK ⏱️</span>
                    <div class="shot-clock-display">
                        @ShotClockSeconds
                    </div>
                    <div class="shot-clock-actions">
                        <button class="btn-shot @(IsShotClockRunning ? "btn-pause" : "btn-start")" @onclick="ToggleShotClock">
                            @(IsShotClockRunning ? "⏸" : "▶")
                        </button>
                        <button class="btn-shot btn-shot-24" @onclick="() => ResetShotClock(24)">24s</button>
                        <button class="btn-shot btn-shot-14" @onclick="() => ResetShotClock(14)">14s</button>
                    </div>
                </div>
            </div>

            <div class="team-panel team-panel-right flex-fill" style="order: 3; min-width: 0;">
                <div class="team-header">
                    <img src="@Team2LogoUrl" alt="@Team2Name Logo" class="team-logo-lg" />
                    <h2>@Team2Name</h2>
                </div>

                <div class="possession-toggle">
                    <button class="btn-poss @(Team2Possession ? "active" : "")" @onclick="() => TogglePossession(2)">
                        POSSESSION ►
                    </button>
                </div>

                <div class="big-score-display">
                    @Team2Score
                </div>

                <div class="score-controls">
                    <button class="btn-score btn-add" @onclick="() => ChangeScore(2, 1)">+1 ➕</button>
                    <button class="btn-score btn-add" @onclick="() => ChangeScore(2, 2)">+2 ➕</button>
                    <button class="btn-score btn-add" @onclick="() => ChangeScore(2, 3)">+3 ➕</button>
                    <button class="btn-score btn-sub" @onclick="() => ChangeScore(2, -1)">-1 ➖</button>
                </div>

                <div class="team-extra-controls">
                    <div class="stat-box">
                        <span>TIMEOUTS ⏱️</span>
                        <div class="stat-counter">
                            <button @onclick="() => ChangeTimeouts(2, -1)">-</button>
                            <strong>@Team2Timeouts</strong>
                            <button @onclick="() => ChangeTimeouts(2, 1)">+</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="log-section w-100 mt-3">
            <h3>📋 Live Action Log</h3>
            <div class="log-box">
                @if (ActionLogs.Count == 0)
                {
                    <div class="empty-log">No scoring events logged yet. 📭</div>
                }
                else
                {
                    <ul>
                        @foreach (var log in ActionLogs)
                        {
                            <li>
                                <span class="log-time">[@log.Timestamp.ToString("hh:mm:ss tt")]</span>
                                <span class="log-clock">(@FormatTime(log.GameClockTime) - Q@Period)</span>
                                <span class="log-msg">@log.Message</span>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    }
</div>


@code {
    public class ActionLog
    {
        public DateTime Timestamp { get; set; } = DateTime.Now;
        public int GameClockTime { get; set; }
        public string Message { get; set; } = string.Empty;
    }

    private HubConnection? hubConnection;

    // Available and Selected Matches
    private List<MatchDto> AvailableMatches = new();
    private MatchDto? SelectedMatch;

    // Active Teams State
    private string Team1Name = "Team 1";
    private string Team1LogoUrl = "images/default-logo.png";
    private int Team1Score = 0;
    private int Team1Timeouts = 0;
    private bool Team1Possession = true;

    private string Team2Name = "Team 2";
    private string Team2LogoUrl = "images/default-logo.png";
    private int Team2Score = 0;
    private int Team2Timeouts = 0;
    private bool Team2Possession = false;

    // Period State
    private int Period = 1;
    private string PeriodText => Period switch
    {
        1 => "1ST QUARTER",
        2 => "2ND QUARTER",
        3 => "3RD QUARTER",
        4 => "4TH QUARTER",
        _ => $"OVERTIME {Period - 4}"
    };

    // Clock States & Editing
    private int DefaultQuarterMinutes = 10;
    private int GameClockSeconds = 600;
    private int ShotClockSeconds = 24;
    private bool IsGameClockRunning = false;
    private bool IsShotClockRunning = false;

    private bool isEditingClock = false;
    private int editMinutes = 10;
    private int editSeconds = 0;

    private Timer? MasterTimer;
    private List<ActionLog> ActionLogs = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAvailableMatchesAsync();

        MasterTimer = new Timer(1000);
        MasterTimer.Elapsed += OnTimerTick;
        MasterTimer.AutoReset = true;

        // 🏆 1. Connected to unified SportsHub
        hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/sportshub"))
            .WithAutomaticReconnect()
            .Build();

        // 📡 2. Listen for state request with optional sport filter
        hubConnection.On<string?>("RequestStateFromHost", async (requestedSport) =>
        {
            if (string.IsNullOrEmpty(requestedSport) || string.Equals(requestedSport, "Basketball", StringComparison.OrdinalIgnoreCase))
            {
                await BroadcastGameStateAsync();
            }
        });

        await hubConnection.StartAsync();
    }

    private async Task LoadAvailableMatchesAsync()
    {
        try
        {
            var allMatches = await Http.GetFromJsonAsync<List<MatchDto>>(Navigation.ToAbsoluteUri("api/matches")) ?? new();

            // Exclude matches where StatusText is "Concluded" & keep Basketball matches
            AvailableMatches = allMatches
                .Where(m => !string.Equals(m.StatusText, "Concluded", StringComparison.OrdinalIgnoreCase) 
                         && string.Equals(m.Sport, "Basketball", StringComparison.OrdinalIgnoreCase))
                .ToList();

            var defaultMatch = AvailableMatches.FirstOrDefault();
            if (defaultMatch != null)
            {
                await SelectMatchAsync(defaultMatch);
            }
            else
            {
                SelectedMatch = null;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading matches: {ex.Message}");
        }
    }

    private async Task OnMatchSelected(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out Guid matchId))
        {
            var match = AvailableMatches.FirstOrDefault(m => m.Id == matchId);
            if (match != null)
            {
                await SelectMatchAsync(match);
            }
        }
        else
        {
            SelectedMatch = null;
        }
    }

    private async Task SelectMatchAsync(MatchDto match)
    {
        SelectedMatch = match;

        Team1Name = match.Team1?.Name ?? "TBD";
        Team1LogoUrl = GetImageSrc(match.Team1?.Logo);
        Team1Score = match.Team1Score;

        Team2Name = match.Team2?.Name ?? "TBD";
        Team2LogoUrl = GetImageSrc(match.Team2?.Logo);
        Team2Score = match.Team2Score;

        // 🔴 1. Ensure ONLY the selected Basketball match is IsLive = true in DB
        try
        {
            var allMatchesInDb = await Http.GetFromJsonAsync<List<MatchDto>>(Navigation.ToAbsoluteUri("api/matches")) ?? new();
            var basketballMatches = allMatchesInDb
                .Where(m => string.Equals(m.Sport, "Basketball", StringComparison.OrdinalIgnoreCase))
                .ToList();

            foreach (var m in basketballMatches)
            {
                bool shouldBeLive = (m.Id == match.Id);
                if (m.IsLive != shouldBeLive)
                {
                    m.IsLive = shouldBeLive;
                    await SaveMatchToDbAsync(m);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error updating IsLive status across matches: {ex.Message}");
        }

        SelectedMatch.IsLive = true;

        LogEvent($"Loaded Match #{match.GameNumber}: {Team1Name} vs {Team2Name}");
        
        // 📡 2. Save & Broadcast state so Dashboard updates immediately
        await SaveMatchToDbAsync(SelectedMatch);
        await BroadcastGameStateAsync();
    }

    private async Task ConcludeMatchAsync()
    {
        if (SelectedMatch == null) return;

        bool confirmed = await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to conclude GAME #{SelectedMatch.GameNumber} ({Team1Name} vs {Team2Name})?");
        if (!confirmed) return;

        // 🏁 1. Update Match status & stop clocks
        SelectedMatch.StatusText = "Concluded";
        SelectedMatch.IsLive = false;
        IsGameClockRunning = false;
        IsShotClockRunning = false;

        // 🏆 2. Parse & Increment winning team's Record (+1)
        if (Team1Score > Team2Score && SelectedMatch.Team1 != null)
        {
            SelectedMatch.Team1.Record = IncrementRecord(SelectedMatch.Team1.Record);
            await SaveTeamToDbAsync(SelectedMatch.Team1);
            LogEvent($"🏆 {Team1Name} won with {Team1Score} PTS! Team Record updated to '{SelectedMatch.Team1.Record}'.");
        }
        else if (Team2Score > Team1Score && SelectedMatch.Team2 != null)
        {
            SelectedMatch.Team2.Record = IncrementRecord(SelectedMatch.Team2.Record);
            await SaveTeamToDbAsync(SelectedMatch.Team2);
            LogEvent($"🏆 {Team2Name} won with {Team2Score} PTS! Team Record updated to '{SelectedMatch.Team2.Record}'.");
        }
        else
        {
            LogEvent("🤝 Match concluded in a tie! No record updates applied.");
        }

        // 💾 3. Save Match state to DB
        await SaveMatchToDbAsync(SelectedMatch);
        LogEvent($"🏁 GAME #{SelectedMatch.GameNumber} has been officially Concluded!");

        // 📡 4. Broadcast final state to SignalR
        await BroadcastGameStateAsync();

        // 🔄 5. Reload available matches (removes concluded match from dropdown)
        await LoadAvailableMatchesAsync();
    }

    private string IncrementRecord(string currentRecord)
    {
        if (int.TryParse(currentRecord, out int currentVal))
        {
            return (currentVal + 1).ToString();
        }

        return "1";
    }

    private async Task SaveMatchToDbAsync(MatchDto match)
    {
        try
        {
            await Http.PutAsJsonAsync(Navigation.ToAbsoluteUri($"api/matches/{match.Id}"), match);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error updating match {match.Id} in DB: {ex.Message}");
        }
    }

    private async Task SaveTeamToDbAsync(TeamDto team)
    {
        try
        {
            // 🎯 Route matches TeamController endpoint: PUT api/team/{id}
            var response = await Http.PutAsJsonAsync(Navigation.ToAbsoluteUri($"api/team/{team.Id}"), team);
            if (!response.IsSuccessStatusCode)
            {
                Console.WriteLine($"Failed to update team {team.Id}: {response.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error updating team record in DB: {ex.Message}");
        }
    }

    private async Task BroadcastGameStateAsync()
    {
        if (SelectedMatch == null) return;

        SelectedMatch.Team1Score = Team1Score;
        SelectedMatch.Team2Score = Team2Score;
        SelectedMatch.PeriodDetails = PeriodText;

        if (hubConnection is not null && hubConnection.State == HubConnectionState.Connected)
        {
            var state = new
            {
                Sport = SelectedMatch.Sport ?? "Basketball", // 🎯 CRITICAL: Include Sport name!
                MatchId = SelectedMatch.Id,
                GameNumber = SelectedMatch.GameNumber,
                Team1Name,
                Team1LogoUrl,
                Team1Score,
                Team1Timeouts,
                Team1Possession,
                Team2Name,
                Team2LogoUrl,
                Team2Score,
                Team2Timeouts,
                Team2Possession,
                Period,
                PeriodText,
                GameClockSeconds,
                ShotClockSeconds,
                IsLive = SelectedMatch.IsLive,
                StatusText = SelectedMatch.StatusText,
                RecentEvents = ActionLogs.Select(l => new { GameClock = l.GameClockTime, l.Message }).Take(5).ToList()
            };

            string json = JsonSerializer.Serialize(state);
            await hubConnection.SendAsync("SendMatchState", json); // 🚀 Broadcast via unified SendMatchState
        }
    }

    private async void OnTimerTick(object? sender, ElapsedEventArgs e)
    {
        bool stateChanged = false;

        if (IsGameClockRunning && GameClockSeconds > 0)
        {
            GameClockSeconds--;
            stateChanged = true;

            if (GameClockSeconds == 0)
            {
                IsGameClockRunning = false;
                IsShotClockRunning = false;

                if (SelectedMatch != null)
                {
                    SelectedMatch.IsLive = false;
                    await SaveMatchToDbAsync(SelectedMatch);
                }

                LogEvent($"⌛ End of {PeriodText}!");
            }
        }

        if (IsShotClockRunning && ShotClockSeconds > 0)
        {
            ShotClockSeconds--;
            stateChanged = true;

            if (ShotClockSeconds == 0)
            {
                IsShotClockRunning = false;
                LogEvent("🚨 SHOT CLOCK VIOLATION!");
            }
        }

        if (stateChanged)
        {
            await InvokeAsync(StateHasChanged);
            await BroadcastGameStateAsync();
        }
    }

    private async Task ChangeScore(int team, int delta)
    {
        if (team == 1)
        {
            Team1Score = Math.Max(0, Team1Score + delta);
            LogEvent($"{Team1Name} {(delta > 0 ? $"+{delta}" : $"{delta}")} PTS (Total: {Team1Score}) 🏀");
        }
        else
        {
            Team2Score = Math.Max(0, Team2Score + delta);
            LogEvent($"{Team2Name} {(delta > 0 ? $"+{delta}" : $"{delta}")} PTS (Total: {Team2Score}) 🏀");
        }

        if (delta > 0)
        {
            await ResetShotClock(24, suppressBroadcast: true);
        }

        // 💾 Save score updates to DB
        if (SelectedMatch != null)
        {
            SelectedMatch.Team1Score = Team1Score;
            SelectedMatch.Team2Score = Team2Score;
            await SaveMatchToDbAsync(SelectedMatch);
        }

        await BroadcastGameStateAsync();
    }

    private async Task TogglePossession(int team)
    {
        Team1Possession = (team == 1);
        Team2Possession = (team == 2);
        LogEvent($"Possession arrow switched to {(team == 1 ? Team1Name : Team2Name)} 🏀");

        await BroadcastGameStateAsync();
    }

    private async Task ChangeTimeouts(int team, int delta)
    {
        if (team == 1) Team1Timeouts = Math.Max(0, Team1Timeouts + delta);
        else Team2Timeouts = Math.Max(0, Team2Timeouts + delta);

        await BroadcastGameStateAsync();
    }

    private async Task ToggleGameClock()
    {
        IsGameClockRunning = !IsGameClockRunning;
        IsShotClockRunning = IsGameClockRunning;

        if (IsGameClockRunning && !MasterTimer!.Enabled)
        {
            MasterTimer.Start();
        }

        // 💾 Persist IsLive status to DB and broadcast update
        if (SelectedMatch != null)
        {
            SelectedMatch.IsLive = IsGameClockRunning;
            await SaveMatchToDbAsync(SelectedMatch);
        }

        LogEvent(IsGameClockRunning ? "▶ Game Clock Started" : "⏸ Game Clock Paused");
        await BroadcastGameStateAsync();
    }

    private async Task ToggleShotClock()
    {
        IsShotClockRunning = !IsShotClockRunning;
        await BroadcastGameStateAsync();
    }

    private void EnableClockEdit()
    {
        if (IsGameClockRunning) return; // Only allow editing when paused
        editMinutes = GameClockSeconds / 60;
        editSeconds = GameClockSeconds % 60;
        isEditingClock = true;
    }

    private async Task SaveEditedClock()
    {
        GameClockSeconds = (Math.Max(0, editMinutes) * 60) + Math.Clamp(editSeconds, 0, 59);
        isEditingClock = false;
        LogEvent($"⏱ Clock edited manually to {FormatTime(GameClockSeconds)}");
        await BroadcastGameStateAsync();
    }

    private async Task SetDefaultQuarterMinutes(int minutes)
    {
        DefaultQuarterMinutes = minutes;
        GameClockSeconds = minutes * 60;
        LogEvent($"⚙️ Quarter duration set to {minutes} min");
        await BroadcastGameStateAsync();
    }

    private async Task ResetGameClock()
    {
        IsGameClockRunning = false;
        GameClockSeconds = DefaultQuarterMinutes * 60;

        if (SelectedMatch != null)
        {
            SelectedMatch.IsLive = false;
            await SaveMatchToDbAsync(SelectedMatch);
        }

        LogEvent($"🔄 Game Clock Reset to {DefaultQuarterMinutes}:00");
        await BroadcastGameStateAsync();
    }

    private async Task ResetShotClock(int seconds, bool suppressBroadcast = false)
    {
        ShotClockSeconds = seconds;
        LogEvent($"⏱ Shot Clock Reset to {seconds}s");

        if (!suppressBroadcast)
        {
            await BroadcastGameStateAsync();
        }
    }

    private async Task NextPeriod()
    {
        Period++;
        GameClockSeconds = DefaultQuarterMinutes * 60;
        ShotClockSeconds = 24;
        IsGameClockRunning = false;
        IsShotClockRunning = false;

        if (SelectedMatch != null)
        {
            SelectedMatch.IsLive = false;
            SelectedMatch.PeriodDetails = PeriodText;
            await SaveMatchToDbAsync(SelectedMatch);
        }

        LogEvent($"Entering {PeriodText} 🏀");
        await BroadcastGameStateAsync();
    }

    private async Task PreviousPeriod()
    {
        if (Period > 1)
        {
            Period--;
            GameClockSeconds = DefaultQuarterMinutes * 60;
            ShotClockSeconds = 24;
            IsGameClockRunning = false;
            IsShotClockRunning = false;

            if (SelectedMatch != null)
            {
                SelectedMatch.IsLive = false;
                SelectedMatch.PeriodDetails = PeriodText;
                await SaveMatchToDbAsync(SelectedMatch);
            }

            await BroadcastGameStateAsync();
        }
    }

    private string FormatTime(int totalSeconds)
    {
        int minutes = totalSeconds / 60;
        int seconds = totalSeconds % 60;
        return $"{minutes:D2}:{seconds:D2}";
    }

    private string GetImageSrc(byte[]? imageBytes)
    {
        if (imageBytes == null || imageBytes.Length == 0)
            return "images/default-logo.png";

        string base64 = Convert.ToBase64String(imageBytes);

        int headerLength = Math.Min(imageBytes.Length, 100);
        string headerText = System.Text.Encoding.UTF8.GetString(imageBytes, 0, headerLength);

        if (headerText.Contains("<svg", StringComparison.OrdinalIgnoreCase))
        {
            return $"data:image/svg+xml;base64,{base64}";
        }

        return $"data:image/png;base64,{base64}";
    }

    private void LogEvent(string msg)
    {
        ActionLogs.Insert(0, new ActionLog
        {
            GameClockTime = GameClockSeconds,
            Message = msg
        });
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/dashboard");
    }

    public async ValueTask DisposeAsync()
    {
        MasterTimer?.Stop();
        MasterTimer?.Dispose();

        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}