@page "/volleyball-scorekeeper"

@using Microsoft.AspNetCore.SignalR.Client
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@using System.Text.Json
@using System.Net.Http.Json
@using CASAPahampang.Client.Dtos
@implements IAsyncDisposable
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@inject HttpClient Http
@inject AuthService authService
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="scorekeeper-container">
    <header class="dashboard-header">
        <div class="header-left">
            <button class="btn-back" @onclick="GoBack" type="button">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg>
                <span class="btn-back-label">Dashboard</span>
            </button>
            <div class="header-title">
                <p class="branding-subtitle">CENTRAL AZUCARERA DE SAN ANTONIO</p>
                <h1>Volleyball Scorekeeper</h1>
            </div>
        </div>
        <div class="live-badge">
            <span class="pulse-dot"></span> LIVE
        </div>
    </header>

    <div class="match-selector-card">
        <label class="form-label" for="matchSelect">Active match <span class="label-hint">(concluded matches hidden)</span></label>
        <select id="matchSelect" class="match-select" @onchange="OnMatchSelected">
            <option value="">— Choose a volleyball match —</option>
            @foreach (var match in AvailableMatches)
            {
                <option value="@match.Id" selected="@(SelectedMatch?.Id == match.Id)">
                    GAME @match.GameNumber: @(match.Team1?.Name ?? "TBD") vs @(match.Team2?.Name ?? "TBD") · @match.Venue (@(string.IsNullOrWhiteSpace(match.StatusText) ? "Scheduled" : match.StatusText))
                </option>
            }
        </select>
        @if (SelectedMatch != null)
        {
            <div class="match-status-row">
                <span class="badge badge-active">GAME @SelectedMatch.GameNumber · @SelectedMatch.Sport</span>
                <button class="btn-conclude" @onclick="ConcludeMatchAsync" title="Mark match as Concluded">
                    Conclude match
                </button>
            </div>
        }
        else
        {
            <div class="match-status-row">
                <span class="badge badge-warning">Select a match to begin</span>
            </div>
        }
    </div>

    @if (SelectedMatch == null)
    {
        <div class="empty-state">
            <h4>No match selected</h4>
            <p>Choose an ongoing or upcoming volleyball match above to start scoring.</p>
        </div>
    }
    else
    {
        <!-- Everything needed to score a rally lives in this one screen: no scrolling
             between "see the score" and "tap the buttons" on a phone. -->
        <div class="scoreboard-bar">
            <div class="sb-team sb-team-blue @(ServingTeam == 1 ? "is-serving" : "")" style="order: @(IsSidesSwitched ? 3 : 1);">
                <span class="sb-name">@Team1Name</span>
                <span class="sb-score">@Team1Score</span>
                <span class="sb-sets">Sets <strong>@Team1SetsWon</strong></span>
            </div>

            <div class="sb-set-block" style="order: 2;">
                <span class="sb-set-label">SET</span>
                <span class="sb-set-number">@CurrentSetNumber</span>
                <div class="sb-set-actions">
                    <button class="btn-finish-set" @onclick="FinishCurrentSet">Finish set</button>
                    <button class="btn-switch-sides" @onclick="SwitchSides" aria-label="Switch sides" title="Switch sides">⇄</button>
                </div>
            </div>

            <div class="sb-team sb-team-green @(ServingTeam == 2 ? "is-serving" : "")" style="order: @(IsSidesSwitched ? 1 : 3);">
                <span class="sb-sets">Sets <strong>@Team2SetsWon</strong></span>
                <span class="sb-score">@Team2Score</span>
                <span class="sb-name">@Team2Name</span>
            </div>
        </div>

        <div class="team-controls-grid">
            <div class="team-panel team-panel-blue @(ServingTeam == 1 ? "is-serving" : "")" style="order: @(IsSidesSwitched ? 3 : 1);">
                <div class="team-panel-head">
                    <img src="@Team1LogoUrl" alt="@Team1Name Logo" class="team-logo-sm" />
                    <span class="team-panel-name">@Team1Name</span>
                </div>

                <button class="btn-serve @(ServingTeam == 1 ? "active" : "")" @onclick="() => SetServer(1)">
                    🏐 @(ServingTeam == 1 ? "Serving" : "Set serve")
                </button>

                <div class="score-controls">
                    <button class="btn-score btn-add" @onclick="() => AddPoint(1)">+1 point</button>
                    <button class="btn-score btn-sub" @onclick="() => SubtractPoint(1)">−1</button>
                </div>

                <div class="team-extra-controls">
                    <div class="stat-box">
                        <span>Timeouts <em>(max 2)</em></span>
                        <div class="stat-counter">
                            <button @onclick="() => ChangeTimeouts(1, -1)" aria-label="Decrease timeouts">−</button>
                            <strong>@Team1Timeouts</strong>
                            <button @onclick="() => ChangeTimeouts(1, 1)" aria-label="Increase timeouts">+</button>
                        </div>
                    </div>
                    <div class="stat-box">
                        <span>Subs <em>(max 6)</em></span>
                        <div class="stat-counter">
                            <button @onclick="() => ChangeSubs(1, -1)" aria-label="Decrease subs">−</button>
                            <strong>@Team1Subs</strong>
                            <button @onclick="() => ChangeSubs(1, 1)" aria-label="Increase subs">+</button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="team-panel team-panel-green @(ServingTeam == 2 ? "is-serving" : "")" style="order: @(IsSidesSwitched ? 1 : 3);">
                <div class="team-panel-head team-panel-head-right">
                    <span class="team-panel-name">@Team2Name</span>
                    <img src="@Team2LogoUrl" alt="@Team2Name Logo" class="team-logo-sm" />
                </div>

                <button class="btn-serve @(ServingTeam == 2 ? "active" : "")" @onclick="() => SetServer(2)">
                    🏐 @(ServingTeam == 2 ? "Serving" : "Set serve")
                </button>

                <div class="score-controls">
                    <button class="btn-score btn-add" @onclick="() => AddPoint(2)">+1 point</button>
                    <button class="btn-score btn-sub" @onclick="() => SubtractPoint(2)">−1</button>
                </div>

                <div class="team-extra-controls">
                    <div class="stat-box">
                        <span>Timeouts <em>(max 2)</em></span>
                        <div class="stat-counter">
                            <button @onclick="() => ChangeTimeouts(2, -1)" aria-label="Decrease timeouts">−</button>
                            <strong>@Team2Timeouts</strong>
                            <button @onclick="() => ChangeTimeouts(2, 1)" aria-label="Increase timeouts">+</button>
                        </div>
                    </div>
                    <div class="stat-box">
                        <span>Subs <em>(max 6)</em></span>
                        <div class="stat-counter">
                            <button @onclick="() => ChangeSubs(2, -1)" aria-label="Decrease subs">−</button>
                            <strong>@Team2Subs</strong>
                            <button @onclick="() => ChangeSubs(2, 1)" aria-label="Increase subs">+</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <details class="set-history-section">
            <summary>Set history <span class="log-count">(@CompletedSets.Count)</span></summary>
            <div class="set-history-body">
                <div class="match-format-tag">Best of 5 · first to 25 pts</div>
                @if (CompletedSets.Count == 0)
                {
                    <p class="empty-history">No sets completed yet.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="history-table">
                            <thead>
                                <tr>
                                    <th>Set</th>
                                    <th>@Team1Name</th>
                                    <th>@Team2Name</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var set in CompletedSets)
                                {
                                    <tr>
                                        <td>Set @set.SetNumber</td>
                                        <td class="@(set.Team1Score > set.Team2Score ? "winner-score" : "")">@set.Team1Score</td>
                                        <td class="@(set.Team2Score > set.Team1Score ? "winner-score" : "")">@set.Team2Score</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </details>

        <details class="log-section">
            <summary>Match log <span class="log-count">(@ActionLogs.Count)</span></summary>
            <div class="log-box">
                @if (ActionLogs.Count == 0)
                {
                    <div class="empty-log">No match events logged yet.</div>
                }
                else
                {
                    <ul>
                        @foreach (var log in ActionLogs)
                        {
                            <li>
                                <span class="log-time">[@log.Timestamp.ToString("hh:mm:ss tt")]</span>
                                <span class="log-msg">@log.Message</span>
                            </li>
                        }
                    </ul>
                }
            </div>
        </details>
    }
</div>


@code {
    public class CompletedSetRecord
    {
        public int SetNumber { get; set; }
        public int Team1Score { get; set; }
        public int Team2Score { get; set; }
    }

    public class ActionLog
    {
        public DateTime Timestamp { get; set; } = DateTime.Now;
        public string Message { get; set; } = string.Empty;
    }

    private HubConnection? hubConnection;

    private List<MatchDto> AvailableMatches = new();
    private MatchDto? SelectedMatch;

    // Team States
    private string Team1Name = "Team 1";
    private string Team1LogoUrl = "images/default-logo.png";
    private int Team1Score = 0;
    private int Team1SetsWon = 0;
    private int Team1Timeouts = 0;
    private int Team1Subs = 0;

    private string Team2Name = "Team 2";
    private string Team2LogoUrl = "images/default-logo.png";
    private int Team2Score = 0;
    private int Team2SetsWon = 0;
    private int Team2Timeouts = 0;
    private int Team2Subs = 0;

    private int ServingTeam = 1;
    private int CurrentSetNumber = 1;
    private bool IsSidesSwitched = false; // 🔄 Visual court layout flag

    private List<CompletedSetRecord> CompletedSets = new();
    private List<ActionLog> ActionLogs = new();

    protected override async Task OnInitializedAsync()
    {
        Console.WriteLine("=== [CLIENT DEBUG] OnInitializedAsync Started ===");

        if (!authService.IsInitialized)
            await authService.InitializeAsync();

        if (!authService.IsLoggedIn || !authService.Roles.Contains("Admin"))
        {
            Console.WriteLine("[CLIENT DEBUG] Access Denied -> Redirecting to /login");
            Nav.NavigateTo("login");
            return;
        }

        if (!string.IsNullOrEmpty(authService.AccessToken))
        {
            Http.DefaultRequestHeaders.Authorization = 
                new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", authService.AccessToken);
        }
        await LoadAvailableMatchesAsync();

        hubConnection = new HubConnectionBuilder()
            .WithUrl(Nav.ToAbsoluteUri("/sportshub"))
            .WithAutomaticReconnect()
            .Build();

        hubConnection.On<string?>("RequestStateFromHost", async (requestedSport) =>
        {
            if (string.IsNullOrEmpty(requestedSport) || string.Equals(requestedSport, "Volleyball", StringComparison.OrdinalIgnoreCase))
            {
                await BroadcastMatchStateAsync();
            }
        });

        await hubConnection.StartAsync();
    }

    private async Task LoadAvailableMatchesAsync()
    {
        try
        {
            var allMatches = await Http.GetFromJsonAsync<List<MatchDto>>(Nav.ToAbsoluteUri("api/matches")) ?? new();

            AvailableMatches = allMatches
                .Where(m => !string.Equals(m.StatusText, "Concluded", StringComparison.OrdinalIgnoreCase) 
                         && string.Equals(m.Sport, "Volleyball", StringComparison.OrdinalIgnoreCase))
                .ToList();

            var defaultMatch = AvailableMatches.FirstOrDefault();
            if (defaultMatch != null)
            {
                await SelectMatchAsync(defaultMatch);
            }
            else
            {
                SelectedMatch = null;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading matches: {ex.Message}");
        }
    }

    private async Task OnMatchSelected(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out Guid matchId))
        {
            var match = AvailableMatches.FirstOrDefault(m => m.Id == matchId);
            if (match != null)
            {
                await SelectMatchAsync(match);
            }
        }
        else
        {
            SelectedMatch = null;
        }
    }

    private async Task SelectMatchAsync(MatchDto match)
    {
        SelectedMatch = match;

        Team1Name = match.Team1?.Name ?? "TBD";
        Team1LogoUrl = GetImageSrc(match.Team1?.Logo);
        Team1SetsWon = match.Team1Score;

        Team2Name = match.Team2?.Name ?? "TBD";
        Team2LogoUrl = GetImageSrc(match.Team2?.Logo);
        Team2SetsWon = match.Team2Score;

        try
        {
            var allMatchesInDb = await Http.GetFromJsonAsync<List<MatchDto>>(Nav.ToAbsoluteUri("api/matches")) ?? new();
            var volleyballMatches = allMatchesInDb
                .Where(m => string.Equals(m.Sport, "Volleyball", StringComparison.OrdinalIgnoreCase))
                .ToList();

            foreach (var m in volleyballMatches)
            {
                bool shouldBeLive = (m.Id == match.Id);
                if (m.IsLive != shouldBeLive)
                {
                    m.IsLive = shouldBeLive;
                    await SaveMatchToDbAsync(m);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error updating IsLive status across matches: {ex.Message}");
        }

        SelectedMatch.IsLive = true;

        LogEvent($"Loaded Match #{match.GameNumber}: {Team1Name} vs {Team2Name}");

        await SaveMatchToDbAsync(SelectedMatch);
        await BroadcastMatchStateAsync();
    }

    private async Task ConcludeMatchAsync()
    {
        if (SelectedMatch == null) return;

        bool confirmed = await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to conclude GAME #{SelectedMatch.GameNumber} ({Team1Name} vs {Team2Name})?");
        if (!confirmed) return;

        SelectedMatch.Team1Score = Team1SetsWon;
        SelectedMatch.Team2Score = Team2SetsWon;
        SelectedMatch.StatusText = "Concluded";
        SelectedMatch.IsLive = false;

        bool team1Wins = Team1SetsWon > Team2SetsWon || (Team1SetsWon == Team2SetsWon && Team1Score > Team2Score);
        bool team2Wins = Team2SetsWon > Team1SetsWon || (Team1SetsWon == Team2SetsWon && Team2Score > Team1Score);

        if (team1Wins && SelectedMatch.Team1 != null)
        {
            SelectedMatch.Team1.Record = IncrementRecord(SelectedMatch.Team1.Record);
            await SaveTeamToDbAsync(SelectedMatch.Team1);
            LogEvent($"🏆 {Team1Name} won the match ({Team1SetsWon} - {Team2SetsWon})! Team Record updated to '{SelectedMatch.Team1.Record}'.");
        }
        else if (team2Wins && SelectedMatch.Team2 != null)
        {
            SelectedMatch.Team2.Record = IncrementRecord(SelectedMatch.Team2.Record);
            await SaveTeamToDbAsync(SelectedMatch.Team2);
            LogEvent($"🏆 {Team2Name} won the match ({Team2SetsWon} - {Team1SetsWon})! Team Record updated to '{SelectedMatch.Team2.Record}'.");
        }
        else
        {
            LogEvent("🤝 Match concluded in a tie! No record updates applied.");
        }

        await SaveMatchToDbAsync(SelectedMatch);
        LogEvent($"🏁 GAME #{SelectedMatch.GameNumber} has been officially Concluded!");

        await BroadcastMatchStateAsync();
        await LoadAvailableMatchesAsync();
    }

    private string IncrementRecord(string currentRecord)
    {
        if (int.TryParse(currentRecord, out int currentVal))
        {
            return (currentVal + 1).ToString();
        }
        return "1";
    }

    private async Task SaveMatchToDbAsync(MatchDto match)
    {
        try
        {
            await Http.PutAsJsonAsync(Nav.ToAbsoluteUri($"api/matches/{match.Id}"), match);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error updating match {match.Id} in DB: {ex.Message}");
        }
    }

    private async Task SaveTeamToDbAsync(TeamDto team)
    {
        try
        {
            var response = await Http.PutAsJsonAsync(Nav.ToAbsoluteUri($"api/team/{team.Id}"), team);
            if (!response.IsSuccessStatusCode)
            {
                Console.WriteLine($"Failed to update team {team.Id}: {response.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error updating team record in DB: {ex.Message}");
        }
    }

    private async Task BroadcastMatchStateAsync()
    {
        if (SelectedMatch == null) return;

        SelectedMatch.Team1Score = Team1SetsWon;
        SelectedMatch.Team2Score = Team2SetsWon;
        SelectedMatch.PeriodDetails = $"SET {CurrentSetNumber}";

        if (hubConnection is not null && hubConnection.State == HubConnectionState.Connected)
        {
            var state = new
            {
                Sport = SelectedMatch.Sport ?? "Volleyball",
                MatchId = SelectedMatch.Id,
                GameNumber = SelectedMatch.GameNumber,
                Team1Name,
                Team1LogoUrl,
                Team1Score = Team1SetsWon,
                Team1CurrentSetScore = Team1Score,
                Team1SetsWon,
                Team1Timeouts,
                Team1Subs,
                Team2Name,
                Team2LogoUrl,
                Team2Score = Team2SetsWon,
                Team2CurrentSetScore = Team2Score,
                Team2SetsWon,
                Team2Timeouts,
                Team2Subs,
                ServingTeam,
                CurrentSetNumber,
                CompletedSets,
                IsSidesSwitched, // 👈 Visual state sent via SignalR
                IsLive = SelectedMatch.IsLive,
                StatusText = SelectedMatch.StatusText,
                RecentEvents = ActionLogs.Select(l => l.Message).Take(5).ToList()
            };

            string json = JsonSerializer.Serialize(state);
            await hubConnection.SendAsync("SendMatchState", json);
        }
    }

    private async Task AddPoint(int team)
    {
        if (team == 1)
        {
            Team1Score++;
            ServingTeam = 1;
            LogEvent($"Point {Team1Name}! ({Team1Score} - {Team2Score}) 🏐");
        }
        else
        {
            Team2Score++;
            ServingTeam = 2;
            LogEvent($"Point {Team2Name}! ({Team1Score} - {Team2Score}) 🏐");
        }

        await BroadcastMatchStateAsync();
    }

    private async Task SubtractPoint(int team)
    {
        if (team == 1 && Team1Score > 0) Team1Score--;
        else if (team == 2 && Team2Score > 0) Team2Score--;

        await BroadcastMatchStateAsync();
    }

    private async Task SetServer(int team)
    {
        ServingTeam = team;
        LogEvent($"Service switched to {(team == 1 ? Team1Name : Team2Name)} 🏐");

        await BroadcastMatchStateAsync();
    }

    private async Task ChangeTimeouts(int team, int delta)
    {
        if (team == 1) Team1Timeouts = Math.Clamp(Team1Timeouts + delta, 0, 2);
        else Team2Timeouts = Math.Clamp(Team2Timeouts + delta, 0, 2);

        await BroadcastMatchStateAsync();
    }

    private async Task ChangeSubs(int team, int delta)
    {
        if (team == 1) Team1Subs = Math.Clamp(Team1Subs + delta, 0, 6);
        else Team2Subs = Math.Clamp(Team2Subs + delta, 0, 6);

        await BroadcastMatchStateAsync();
    }

    private async Task FinishCurrentSet()
    {
        CompletedSets.Add(new CompletedSetRecord
        {
            SetNumber = CurrentSetNumber,
            Team1Score = Team1Score,
            Team2Score = Team2Score
        });

        if (Team1Score > Team2Score) Team1SetsWon++;
        else if (Team2Score > Team1Score) Team2SetsWon++;

        LogEvent($"🏆 Set {CurrentSetNumber} Finished! ({Team1Name} {Team1Score} - {Team2Score} {Team2Name})");

        CurrentSetNumber++;
        Team1Score = 0;
        Team2Score = 0;
        Team1Timeouts = 0;
        Team2Timeouts = 0;
        Team1Subs = 0;
        Team2Subs = 0;

        if (SelectedMatch != null)
        {
            SelectedMatch.Team1Score = Team1SetsWon;
            SelectedMatch.Team2Score = Team2SetsWon;
            SelectedMatch.PeriodDetails = $"SET {CurrentSetNumber}";
            await SaveMatchToDbAsync(SelectedMatch);
        }

        await BroadcastMatchStateAsync();
    }

    private async Task SwitchSides()
    {
        // 🎯 Purely toggle visual position using CSS Order
        IsSidesSwitched = !IsSidesSwitched;
        LogEvent($"🔄 Teams switched court sides! ({(IsSidesSwitched ? Team2Name : Team1Name)} on Left)");

        await BroadcastMatchStateAsync();
    }

    private string GetImageSrc(byte[]? imageBytes)
    {
        if (imageBytes == null || imageBytes.Length == 0)
            return "images/default-logo.png";

        string base64 = Convert.ToBase64String(imageBytes);

        int headerLength = Math.Min(imageBytes.Length, 100);
        string headerText = System.Text.Encoding.UTF8.GetString(imageBytes, 0, headerLength);

        if (headerText.Contains("<svg", StringComparison.OrdinalIgnoreCase))
        {
            return $"data:image/svg+xml;base64,{base64}";
        }

        return $"data:image/png;base64,{base64}";
    }

    private void LogEvent(string msg)
    {
        ActionLogs.Insert(0, new ActionLog { Message = msg });
    }

    private void GoBack()
    {
        Nav.NavigateTo("/dashboard");
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}