@page "/volleyball-scorekeeper"

@using Microsoft.AspNetCore.SignalR.Client
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@using System.Text.Json
@implements IAsyncDisposable
@rendermode InteractiveWebAssembly
@inject NavigationManager Navigation

<div class="scorekeeper-container">
    <header class="dashboard-header">
        <div class="header-left">
            <button class="btn-back" @onclick="GoBack" type="button">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg>
                Dashboard
            </button>
            <div class="header-title">
                <p class="branding-subtitle">CENTRAL AZUCARERA DE SAN ANTONIO</p>
                <h1>VOLLEYBALL SCOREKEEPER CONSOLE 🏐⚡</h1>
            </div>
        </div>
        <div class="live-badge">
            <span class="pulse-dot"></span> MATCH IN PROGRESS
        </div>
    </header>

    <div class="scoreboard-main">
        <div class="team-panel @(ServingTeam == 1 ? "is-serving" : "")">
            <div class="team-header">
                <img src="@Team1LogoUrl" alt="Team 1 Logo" class="team-logo-lg" />
                <h2>@Team1Name</h2>
            </div>

            <div class="team-status-bar">
                <button class="btn-serve @(ServingTeam == 1 ? "active" : "")" @onclick="() => SetServer(1)">
                    🏐 @(ServingTeam == 1 ? "SERVING" : "SET SERVE")
                </button>
                <div class="sets-won-badge">
                    SETS WON: <strong>@Team1SetsWon</strong>
                </div>
            </div>

            <div class="big-score-display">
                @Team1Score
            </div>

            <div class="score-controls">
                <button class="btn-score btn-add" @onclick="() => AddPoint(1)">+1 POINT</button>
                <button class="btn-score btn-sub" @onclick="() => SubtractPoint(1)">-1</button>
            </div>

            <div class="team-extra-controls">
                <div class="stat-box">
                    <span>TIMEOUTS (MAX 2)</span>
                    <div class="stat-counter">
                        <button @onclick="() => ChangeTimeouts(1, -1)">-</button>
                        <strong>@Team1Timeouts</strong>
                        <button @onclick="() => ChangeTimeouts(1, 1)">+</button>
                    </div>
                </div>
                <div class="stat-box">
                    <span>SUBS (MAX 6)</span>
                    <div class="stat-counter">
                        <button @onclick="() => ChangeSubs(1, -1)">-</button>
                        <strong>@Team1Subs</strong>
                        <button @onclick="() => ChangeSubs(1, 1)">+</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="center-console">
            <div class="set-indicator-card">
                <span class="set-label">CURRENT MATCH STATUS</span>
                <div class="current-set-title">SET @CurrentSetNumber</div>
                <div class="match-format-tag">Best of 5 • First to 25 pts</div>
            </div>

            <div class="set-actions-card">
                <button class="btn-action btn-finish-set" @onclick="FinishCurrentSet">
                    🏆 FINISH SET @CurrentSetNumber
                </button>
                <button class="btn-action btn-switch-sides" @onclick="SwitchSides">
                    🔄 SWITCH SIDES
                </button>
            </div>

            <div class="set-history-card">
                <h3>Set History</h3>
                @if (CompletedSets.Count == 0)
                {
                    <p class="empty-history">No sets completed yet.</p>
                }
                else
                {
                    <table class="history-table">
                        <thead>
                            <tr>
                                <th>Set</th>
                                <th>@Team1Name</th>
                                <th>@Team2Name</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var set in CompletedSets)
                            {
                                <tr>
                                    <td>Set @set.SetNumber</td>
                                    <td class="@(set.Team1Score > set.Team2Score ? "winner-score" : "")">@set.Team1Score</td>
                                    <td class="@(set.Team2Score > set.Team1Score ? "winner-score" : "")">@set.Team2Score</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>

        <div class="team-panel @(ServingTeam == 2 ? "is-serving" : "")">
            <div class="team-header">
                <img src="@Team2LogoUrl" alt="Team 2 Logo" class="team-logo-lg" />
                <h2>@Team2Name</h2>
            </div>

            <div class="team-status-bar">
                <button class="btn-serve @(ServingTeam == 2 ? "active" : "")" @onclick="() => SetServer(2)">
                    🏐 @(ServingTeam == 2 ? "SERVING" : "SET SERVE")
                </button>
                <div class="sets-won-badge">
                    SETS WON: <strong>@Team2SetsWon</strong>
                </div>
            </div>

            <div class="big-score-display">
                @Team2Score
            </div>

            <div class="score-controls">
                <button class="btn-score btn-add" @onclick="() => AddPoint(2)">+1 POINT</button>
                <button class="btn-score btn-sub" @onclick="() => SubtractPoint(2)">-1</button>
            </div>

            <div class="team-extra-controls">
                <div class="stat-box">
                    <span>TIMEOUTS (MAX 2)</span>
                    <div class="stat-counter">
                        <button @onclick="() => ChangeTimeouts(2, -1)">-</button>
                        <strong>@Team2Timeouts</strong>
                        <button @onclick="() => ChangeTimeouts(2, 1)">+</button>
                    </div>
                </div>
                <div class="stat-box">
                    <span>SUBS (MAX 6)</span>
                    <div class="stat-counter">
                        <button @onclick="() => ChangeSubs(2, -1)">-</button>
                        <strong>@Team2Subs</strong>
                        <button @onclick="() => ChangeSubs(2, 1)">+</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="log-section">
        <h3>📋 Match Log</h3>
        <div class="log-box">
            @if (ActionLogs.Count == 0)
            {
                <div class="empty-log">No match events logged yet.</div>
            }
            else
            {
                <ul>
                    @foreach (var log in ActionLogs)
                    {
                        <li>
                            <span class="log-time">[@log.Timestamp.ToString("hh:mm:ss tt")]</span>
                            <span class="log-msg">@log.Message</span>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
</div>

@code {
    public class CompletedSetRecord
    {
        public int SetNumber { get; set; }
        public int Team1Score { get; set; }
        public int Team2Score { get; set; }
    }

    public class ActionLog
    {
        public DateTime Timestamp { get; set; } = DateTime.Now;
        public string Message { get; set; } = string.Empty;
    }

    private HubConnection? hubConnection;

    // Team States
    private string Team1Name = "Lady Spikers";
    private string Team1LogoUrl = "https://api.dicebear.com/7.x/identicon/svg?seed=LadySpikers";
    private int Team1Score = 21;
    private int Team1SetsWon = 1;
    private int Team1Timeouts = 1;
    private int Team1Subs = 2;

    private string Team2Name = "Smashers";
    private string Team2LogoUrl = "https://api.dicebear.com/7.x/identicon/svg?seed=Smashers";
    private int Team2Score = 19;
    private int Team2SetsWon = 0;
    private int Team2Timeouts = 0;
    private int Team2Subs = 1;

    private int ServingTeam = 1;
    private int CurrentSetNumber = 2;

    private List<CompletedSetRecord> CompletedSets = new()
    {
        new CompletedSetRecord { SetNumber = 1, Team1Score = 25, Team2Score = 22 }
    };

    private List<ActionLog> ActionLogs = new();

    protected override async Task OnInitializedAsync()
    {
        hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/volleyballhub"))
            .WithAutomaticReconnect()
            .Build();

        hubConnection.On("RequestStateFromHost", async () =>
        {
            await BroadcastMatchStateAsync();
        });

        await hubConnection.StartAsync();
        await BroadcastMatchStateAsync();
    }

    private async Task BroadcastMatchStateAsync()
    {
        if (hubConnection is not null && hubConnection.State == HubConnectionState.Connected)
        {
            var state = new
            {
                Team1Name,
                Team1LogoUrl,
                Team1Score,
                Team1SetsWon,
                Team1Timeouts,
                Team1Subs,
                Team2Name,
                Team2LogoUrl,
                Team2Score,
                Team2SetsWon,
                Team2Timeouts,
                Team2Subs,
                ServingTeam,
                CurrentSetNumber,
                CompletedSets,
                RecentEvents = ActionLogs.Select(l => l.Message).Take(5).ToList()
            };

            string json = JsonSerializer.Serialize(state);
            await hubConnection.SendAsync("SendMatchState", json);
        }
    }

    private async Task AddPoint(int team)
    {
        if (team == 1)
        {
            Team1Score++;
            ServingTeam = 1;
            LogEvent($"Point {Team1Name}! ({Team1Score} - {Team2Score}) 🏐");
        }
        else
        {
            Team2Score++;
            ServingTeam = 2;
            LogEvent($"Point {Team2Name}! ({Team1Score} - {Team2Score}) 🏐");
        }

        await BroadcastMatchStateAsync();
    }

    private async Task SubtractPoint(int team)
    {
        if (team == 1 && Team1Score > 0) Team1Score--;
        else if (team == 2 && Team2Score > 0) Team2Score--;

        await BroadcastMatchStateAsync();
    }

    private async Task SetServer(int team)
    {
        ServingTeam = team;
        LogEvent($"Service switched to {(team == 1 ? Team1Name : Team2Name)} 🏐");

        await BroadcastMatchStateAsync();
    }

    private async Task ChangeTimeouts(int team, int delta)
    {
        if (team == 1) Team1Timeouts = Math.Clamp(Team1Timeouts + delta, 0, 2);
        else Team2Timeouts = Math.Clamp(Team2Timeouts + delta, 0, 2);

        await BroadcastMatchStateAsync();
    }

    private async Task ChangeSubs(int team, int delta)
    {
        if (team == 1) Team1Subs = Math.Clamp(Team1Subs + delta, 0, 6);
        else Team2Subs = Math.Clamp(Team2Subs + delta, 0, 6);

        await BroadcastMatchStateAsync();
    }

    private async Task FinishCurrentSet()
    {
        CompletedSets.Add(new CompletedSetRecord
        {
            SetNumber = CurrentSetNumber,
            Team1Score = Team1Score,
            Team2Score = Team2Score
        });

        if (Team1Score > Team2Score) Team1SetsWon++;
        else if (Team2Score > Team1Score) Team2SetsWon++;

        LogEvent($"🏆 Set {CurrentSetNumber} Finished! ({Team1Name} {Team1Score} - {Team2Score} {Team2Name})");

        CurrentSetNumber++;
        Team1Score = 0;
        Team2Score = 0;
        Team1Timeouts = 0;
        Team2Timeouts = 0;
        Team1Subs = 0;
        Team2Subs = 0;

        await BroadcastMatchStateAsync();
    }

    private async Task SwitchSides()
    {
        var tempName = Team1Name; Team1Name = Team2Name; Team2Name = tempName;
        var tempLogo = Team1LogoUrl; Team1LogoUrl = Team2LogoUrl; Team2LogoUrl = tempLogo;
        var tempScore = Team1Score; Team1Score = Team2Score; Team2Score = tempScore;
        var tempSets = Team1SetsWon; Team1SetsWon = Team2SetsWon; Team2SetsWon = tempSets;

        ServingTeam = ServingTeam == 1 ? 2 : 1;
        LogEvent("🔄 Teams switched court sides!");

        await BroadcastMatchStateAsync();
    }

    private void LogEvent(string msg)
    {
        ActionLogs.Insert(0, new ActionLog { Message = msg });
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/dashboard");
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}