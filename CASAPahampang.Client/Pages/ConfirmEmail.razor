@page "/confirm-email"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using TestWASM.AuthLib.Services
@inject AuthService AuthService
@inject NavigationManager Nav

<PageTitle>Confirm Email | CASA Pahampang</PageTitle>

<div class="confirm-page d-flex align-items-center justify-content-center min-vh-100 p-3">
    <div class="confirm-card text-center">
        @if (isLoading)
        {
            <div class="spinner-border text-primary mb-3" role="status"></div>
            <p class="text-muted">Confirming your account...</p>
        }
        else if (isSuccess)
        {
            <div class="success-badge mb-3">
                <span class="bi bi-check-circle-fill"></span>
            </div>
            <h4 class="fw-bold">Email Confirmed! 🎉</h4>
            <p class="text-muted small mb-4">Your account is verified and you are now signed in.</p>
            <button class="btn-olympic w-100" @onclick='() => Nav.NavigateTo("/")'>
                Go to Home
            </button>
        }
        else
        {
            <div class="error-badge mb-3">
                <span class="bi bi-x-circle-fill"></span>
            </div>
            <h4 class="fw-bold">Confirmation Failed</h4>
            <p class="text-muted small mb-4">@errorMessage</p>
            <button class="btn-olympic-outline w-100" @onclick='() => Nav.NavigateTo("/register")'>
                Back to Register
            </button>
        }
    </div>
</div>

@code {
    private bool isLoading = true;
    private bool isSuccess;
    private string errorMessage = "This link is invalid or has expired.";

    protected override async Task OnInitializedAsync()
    {
        var uri = new Uri(Nav.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);

        var userId = query["userId"];
        var code = query["code"] ?? query["token"];

        if (string.IsNullOrWhiteSpace(userId) || string.IsNullOrWhiteSpace(code))
        {
            isLoading = false;
            return;
        }

        var (success, error) = await AuthService.ConfirmEmailAsync(userId, code);
        isSuccess = success;
        if (!success)
        {
            errorMessage = error ?? "Email confirmation failed.";
        }

        isLoading = false;
    }
}
