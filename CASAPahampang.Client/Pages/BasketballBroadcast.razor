@page "/broadcast"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@implements IAsyncDisposable
@inject HttpClient Http
@inject AuthService authService
@inject NavigationManager Nav
@inject IJSRuntime JSRuntime
@using Microsoft.AspNetCore.SignalR.Client

<div class="broadcaster-container">
    <h3>🏀 Basketball Broadcaster Studio 🎙️🎥</h3>

    <div class="controls-group">
        <button class="btn btn-custom-start" @onclick="StartBroadcasting" disabled="@isBroadcasting">Start Broadcasting 🚀</button>
        <button class="btn btn-custom-stop" @onclick="StopBroadcasting" disabled="@(!isBroadcasting)">Stop Broadcasting 🛑</button>
    </div>

    <div class="video-wrapper">
        <video id="localVideo" autoplay playsinline muted></video>
    </div>

    <div class="status-card">
        <strong>Live Status / Logs:</strong> @statusMessage
    </div>
</div>

@code {
    private HubConnection? hubConnection;
    private bool isBroadcasting = false;
    private string statusMessage = "Ready to broadcast.";
    private const string RoomName = "basketball";
    private DotNetObjectReference<object>? dotNetRef;

    protected override async Task OnInitializedAsync()
    {
        

        dotNetRef = DotNetObjectReference.Create<object>(this);
        //This is for the authentication and authorization
        Console.WriteLine("=== [CLIENT DEBUG] OnInitializedAsync Started ===");

        if (!authService.IsInitialized)
            await authService.InitializeAsync();

        if (!authService.IsLoggedIn || !authService.Roles.Contains("Admin"))
        {
            Console.WriteLine("[CLIENT DEBUG] Access Denied -> Redirecting to /login");
            Nav.NavigateTo("login");
            return;
        }

        if (!string.IsNullOrEmpty(authService.AccessToken))
        {
            Http.DefaultRequestHeaders.Authorization = 
                new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", authService.AccessToken);
        }
        //Authentication and authorization ends here......
        hubConnection = new HubConnectionBuilder()
            .WithUrl(Nav.ToAbsoluteUri("/chathub"))
            .Build();

        hubConnection.On<string, string, string>("ReceiveSignal", async (senderId, type, payload) =>
        {
            await JSRuntime.InvokeVoidAsync("handleSignalingData", senderId, type, payload);
        });

        await hubConnection.StartAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && dotNetRef != null)
        {
            await JSRuntime.InvokeVoidAsync("initWebRTC", dotNetRef);
            await JSRuntime.InvokeVoidAsync("joinGameRoom", RoomName);
        }
    }

    private async Task StartBroadcasting()
    {
        if (hubConnection != null)
        {
            isBroadcasting = true;
            statusMessage = "Broadcasting basketball live! Waiting for viewers...";
            await JSRuntime.InvokeVoidAsync("startBroadcast", RoomName, "Basketball Host");
        }
    }

    private async Task StopBroadcasting()
    {
        isBroadcasting = false;
        statusMessage = "Broadcast stopped. Ready to restart.";
        await JSRuntime.InvokeVoidAsync("stopBroadcast");
    }

    [JSInvokable]
    public async Task SendSignal(string targetConnectionId, string type, string payload)
    {
        if (hubConnection != null)
        {
            await hubConnection.SendAsync("SendSignal", targetConnectionId, type, payload);
        }
    }

    [JSInvokable]
    public async Task BroadcastWebcamStarted(string roomName, string userName)
    {
        if (hubConnection != null)
        {
            await hubConnection.SendAsync("BroadcastWebcamStarted", roomName, userName);
        }
    }

    [JSInvokable]
    public async Task BroadcastWebcamStopped(string roomName)
    {
        if (hubConnection != null)
        {
            await hubConnection.SendAsync("BroadcastWebcamStopped", roomName);
        }
    }

    [JSInvokable]
    public async Task JoinRoom(string roomName)
    {
        if (hubConnection != null)
        {
            await hubConnection.SendAsync("JoinRoom", roomName);
        }
    }

    [JSInvokable]
    public async Task LeaveRoom(string roomName)
    {
        if (hubConnection != null)
        {
            await hubConnection.SendAsync("LeaveRoom", roomName);
        }
    }
@* 
    public async ValueTask DisposeAsync()
    {
        dotNetRef?.Dispose();
        await JSRuntime.InvokeVoidAsync("stopBroadcast");
        if (hubConnection != null)
        {
            await hubConnection.DisposeAsync();
        }
    } *@
    public async ValueTask DisposeAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("stopBroadcast");
        }
        catch (JSDisconnectedException)
        {
            // Browser/circuit already tore down the JS side — nothing left to clean up.
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[DisposeAsync] stopBroadcast cleanup failed: {ex.Message}");
        }
        finally
        {
            dotNetRef?.Dispose();
        }

        if (hubConnection != null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}