@page "/dashboard"
@using System.Net.Http.Json
@inject HttpClient Http
@using Microsoft.AspNetCore.SignalR.Client
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@using CASAPahampang.Client.Dtos
@implements IAsyncDisposable
@rendermode InteractiveWebAssembly
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="dashboard-container">
    <header class="dashboard-header">
        <div class="header-left">
            <div class="nav-buttons">
                <button class="btn-back" @onclick="GoBack" type="button">
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg>
                    Back
                </button>
                <button class="btn-bingo" @onclick="GoToBingo" type="button">
                    🎯 Bingo Game
                </button>
            </div>
            <div class="header-title">
                <p class="branding-subtitle">CENTRAL AZUCARERA DE SAN ANTONIO</p>
                <h1>CASA PAHAMPANG ⚡</h1>
            </div>
        </div>
        <div class="live-badge">
            <span class="pulse-dot"></span> LIVE TOURNAMENT
        </div>
    </header>

    <div class="row">
        <div class="col-md-6 col-12">
            <section class="sport-section">
                <div class="section-header">
                    <h2>🏀 Basketball</h2>
                    <span class="game-count">6 Teams • 3 Matches</span>
                </div>

                <div class="matches-list">
                    @foreach (var match in BasketballMatches)
                    {
                        <div class="match-row">
                            <div class="match-info">
                                <span class="game-num">GAME @match.GameNumber</span>
                                <span class="venue">@match.Venue</span>
                                <span class="match-extra mobile-only">@match.PeriodDetails</span>
                            </div>

                            <div class="match-versus">
                                <div class="team-cell team-left">
                                    <div class="team-text">
                                        <span class="team-name">@(match.Team1?.Name ?? "TBD")</span>
                                        <span class="team-record">@(match.Team1?.Record ?? "0")</span>
                                    </div>
                                    <img src="@GetImageSrc(match.Team1?.Logo)" alt="@(match.Team1?.Name ?? "Team") Logo" class="team-logo" />
                                </div>

                                <div class="score-cell">
                                    @if (match.IsLive)
                                    {
                                        <div class="live-score">
                                            <span>@match.Team1Score</span>
                                            <span class="score-dash">-</span>
                                            <span>@match.Team2Score</span>
                                        </div>
                                        <span class="status-badge status-live">@match.StatusText</span>
                                    }
                                    else
                                    {
                                        <div class="time-display">@match.StatusText</div>
                                        <span class="status-badge status-final">@match.PeriodDetails</span>
                                    }
                                </div>

                                <div class="team-cell team-right">
                                    <img src="@GetImageSrc(match.Team2?.Logo)" alt="@(match.Team2?.Name ?? "Team") Logo" class="team-logo" />
                                    <div class="team-text">
                                        <span class="team-name">@(match.Team2?.Name ?? "TBD")</span>
                                        <span class="team-record">@(match.Team2?.Record ?? "0")</span>
                                    </div>
                                </div>
                            </div>

                            <div class="match-extra desktop-only">
                                <span>@match.PeriodDetails</span>
                            </div>
                        </div>
                    }
                </div>
            </section>

            <section class="sport-section">
                <div class="section-header">
                    <h2>🏐 Volleyball</h2>
                    <span class="game-count">6 Teams • 3 Matches</span>
                </div>

                <div class="matches-list">
                    @foreach (var match in VolleyballMatches)
                    {
                        <div class="match-row">
                            <div class="match-info">
                                <span class="game-num">GAME @match.GameNumber</span>
                                <span class="venue">@match.Venue</span>
                                <span class="match-extra mobile-only">@match.PeriodDetails</span>
                            </div>

                            <div class="match-versus">
                                <div class="team-cell team-left">
                                    <div class="team-text">
                                        <span class="team-name">@(match.Team1?.Name ?? "TBD")</span>
                                        <span class="team-record">@(match.Team1?.Record ?? "0-0")</span>
                                    </div>
                                    <img src="@GetImageSrc(match.Team1?.Logo)" alt="@(match.Team1?.Name ?? "Team") Logo" class="team-logo" />
                                </div>

                                <div class="score-cell">
                                    @if (match.IsLive)
                                    {
                                        <div class="live-score">
                                            <span>@match.Team1Score</span>
                                            <span class="score-dash">-</span>
                                            <span>@match.Team2Score</span>
                                        </div>
                                        <span class="status-badge status-live">@match.StatusText</span>
                                    }
                                    else
                                    {
                                        <div class="time-display">@match.StatusText</div>
                                        <span class="status-badge status-final">@match.PeriodDetails</span>
                                    }
                                </div>

                                <div class="team-cell team-right">
                                    <img src="@GetImageSrc(match.Team2?.Logo)" alt="@(match.Team2?.Name ?? "Team") Logo" class="team-logo" />
                                    <div class="team-text">
                                        <span class="team-name">@(match.Team2?.Name ?? "TBD")</span>
                                        <span class="team-record">@(match.Team2?.Record ?? "0-0")</span>
                                    </div>
                                </div>
                            </div>

                            <div class="match-extra desktop-only">
                                <span>@match.PeriodDetails</span>
                            </div>
                        </div>
                    }
                </div>
            </section>
        </div>

        <div class="col-md-6 col-12">
            <section class="chat-section">
                <div class="section-header">
                    <h2>💬 Live Fan Chat</h2>
                    <span class="game-count">@OnlineFanCount Fans Online</span>
                </div>

                <div class="chatbox-card">
                    <div class="chatbox-user-bar">
                        <div class="avatar-picker-wrapper">
                            <button type="button" class="btn-avatar-select" @onclick="ToggleAvatarPicker">
                                <img src="@SelectedAvatarUrl" alt="Selected Avatar" class="current-avatar-preview" />
                                <span class="change-lbl">Avatar ✏️</span>
                            </button>

                            @if (showAvatarPicker)
                            {
                                <div class="avatar-grid-dropdown">
                                    <div class="avatar-grid-header">
                                        <span>Choose Avatar 🎨</span>
                                        <button type="button" class="btn-close-picker" @onclick="ToggleAvatarPicker">✕</button>
                                    </div>
                                    <div class="avatar-grid">
                                        @foreach (var avatar in AvatarList)
                                        {
                                            <div class="avatar-item @(SelectedAvatarUrl == avatar.Url ? "selected" : "")" 
                                                 @onclick="() => SelectAvatar(avatar.Url)">
                                                <img src="@avatar.Url" alt="@avatar.Name" />
                                                <span class="avatar-name">@avatar.Name</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>

                        <label for="username-input" class="username-label">Name:</label>
                        <input id="username-input" type="text" class="username-input" 
                               @bind="CurrentUsername" @bind:event="oninput" placeholder="Enter handle..." />
                    </div>

                    <div id="chat-messages-container" class="chatbox-messages">
                        @foreach (var msg in ChatMessages)
                        {
                            <div class="chat-message @(msg.IsUser ? "my-message" : "other-message")">
                                <img src="@msg.AvatarUrl" alt="Avatar" class="chat-avatar" />
                                <div class="msg-bubble">
                                    <div class="msg-header">
                                        <span class="msg-user">@msg.Username</span>
                                        <span class="msg-time">@msg.TimeStamp.ToString("hh:mm tt")</span>
                                    </div>
                                    <div class="msg-text">@msg.Message</div>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="chatbox-footer">
                        <input type="text" class="chat-input" placeholder="Join the discussion..." 
                               @bind="NewMessageText" @bind:event="oninput" @onkeyup="HandleKeyUp" />
                        <button class="btn-send" @onclick="SendMessage" type="button">
                            <svg viewBox="0 0 24 24" fill="currentColor">
                                <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
                            </svg>
                        </button>
                    </div>
                </div>
            </section>
        </div>
    </div>
</div>
@code {
    private HubConnection? chatHubConnection;
    private HubConnection? basketballHubConnection;
    private HubConnection? volleyballHubConnection;

    private string NewMessageText = string.Empty;
    private string CurrentUsername = "User";

    private int OnlineFanCount = 1;
    private bool shouldScrollToBottom = false;
    private const int MaxMessageLimit = 50;

    private string SelectedAvatarUrl = "https://api.dicebear.com/7.x/bottts/svg?seed=Panther";
    private bool showAvatarPicker = false;

    private List<AvatarOptionDto> AvatarList = new()
    {
        new AvatarOptionDto { Id = Guid.NewGuid(), Name = "Panther", Url = "https://api.dicebear.com/7.x/bottts/svg?seed=Panther" },
        new AvatarOptionDto { Id = Guid.NewGuid(), Name = "Eagle", Url = "https://api.dicebear.com/7.x/bottts/svg?seed=Eagle" },
        new AvatarOptionDto { Id = Guid.NewGuid(), Name = "Tiger", Url = "https://api.dicebear.com/7.x/bottts/svg?seed=Tiger" },
        new AvatarOptionDto { Id = Guid.NewGuid(), Name = "Spiker", Url = "https://api.dicebear.com/7.x/bottts/svg?seed=Spiker" },
        new AvatarOptionDto { Id = Guid.NewGuid(), Name = "Falcon", Url = "https://api.dicebear.com/7.x/bottts/svg?seed=Falcon" },
        new AvatarOptionDto { Id = Guid.NewGuid(), Name = "Blaze", Url = "https://api.dicebear.com/7.x/bottts/svg?seed=Blaze" },
        new AvatarOptionDto { Id = Guid.NewGuid(), Name = "Knight", Url = "https://api.dicebear.com/7.x/bottts/svg?seed=Knight" },
        new AvatarOptionDto { Id = Guid.NewGuid(), Name = "Rocket", Url = "https://api.dicebear.com/7.x/bottts/svg?seed=Rocket" }
    };

    private List<ChatMessageDto> ChatMessages = new();

    private List<MatchDto> BasketballMatches = new();
    private List<MatchDto> VolleyballMatches = new();

    protected override async Task OnInitializedAsync()
    {
        // Load match data from database API endpoints
        try
        {
            var allMatches = await Http.GetFromJsonAsync<List<MatchDto>>(Navigation.ToAbsoluteUri("api/matches")) ?? new();
            BasketballMatches = allMatches
                .Where(m => string.Equals(m.Sport, "Basketball", StringComparison.OrdinalIgnoreCase))
                .ToList();

            // 🏐 Filter volleyball matches
            VolleyballMatches = allMatches
                .Where(m => string.Equals(m.Sport, "Volleyball", StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading matches from database: {ex.Message}");
        }

        // Add initial chat entries
        //AddChatMessage(new ChatMessageDto { Id = Guid.NewGuid(), Username = "Mark", Message = "Tigers are looking strong in Q4! 🐅", TimeStamp = DateTime.Now.AddMinutes(-12), IsUser = false, AvatarUrl = "https://api.dicebear.com/7.x/bottts/svg?seed=Mark" });
        //AddChatMessage(new ChatMessageDto { Id = Guid.NewGuid(), Username = "Sarah", Message = "Spikers take set 3! What a comeback! 🏐", TimeStamp = DateTime.Now.AddMinutes(-5), IsUser = false, AvatarUrl = "https://api.dicebear.com/7.x/bottts/svg?seed=Sarah" });

        // 💬 1. Chat Hub Connection
        chatHubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/chathub"))
            .WithAutomaticReconnect()
            .Build();

        chatHubConnection.On<string, string, string, DateTime>("ReceiveChatMessage", (user, message, avatarUrl, timestamp) =>
        {
            bool isMe = string.Equals(user, CurrentUsername, StringComparison.OrdinalIgnoreCase);

            AddChatMessage(new ChatMessageDto
            {
                Id = Guid.NewGuid(),
                Username = user,
                Message = message,
                AvatarUrl = avatarUrl,
                TimeStamp = timestamp,
                IsUser = isMe
            });

            _ = InvokeAsync(StateHasChanged);
        });

        chatHubConnection.On<int>("UpdateOnlineCount", (count) =>
        {
            OnlineFanCount = count;
            _ = InvokeAsync(StateHasChanged);
        });

        // 🏀 2. Basketball Hub Connection
        basketballHubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/basketballhub"))
            .WithAutomaticReconnect()
            .Build();

        basketballHubConnection.On<TeamDto>("ReceiveTeamUpdated", (updatedTeam) =>
        {
            UpdateTeamInMatches(BasketballMatches, updatedTeam);
            _ = InvokeAsync(StateHasChanged);
        });

        // 🏐 3. Volleyball Hub Connection
        volleyballHubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/volleyballhub"))
            .WithAutomaticReconnect()
            .Build();

        // ⚡ Listen for full match snapshots from Volleyball console / scoreboard
        volleyballHubConnection.On<string>("ReceiveMatchState", (matchStateJson) =>
        {
            try
            {
                var updatedMatch = System.Text.Json.JsonSerializer.Deserialize<MatchDto>(matchStateJson);
                if (updatedMatch != null)
                {
                    var existing = VolleyballMatches.FirstOrDefault(m => m.Id == updatedMatch.Id || m.GameNumber == updatedMatch.GameNumber);
                    if (existing != null)
                    {
                        existing.Team1Score = updatedMatch.Team1Score;
                        existing.Team2Score = updatedMatch.Team2Score;
                        existing.IsLive = updatedMatch.IsLive;
                        existing.StatusText = updatedMatch.StatusText;
                        existing.PeriodDetails = updatedMatch.PeriodDetails;
                    }
                    else
                    {
                        VolleyballMatches.Add(updatedMatch);
                    }
                    _ = InvokeAsync(StateHasChanged);
                }
            }
            catch
            {
                // Ignore invalid JSON payloads gracefully
            }
        });

        // Start all hub connections concurrently
        await Task.WhenAll(
            chatHubConnection.StartAsync(),
            basketballHubConnection.StartAsync(),
            volleyballHubConnection.StartAsync()
        );

        // Optionally request immediate volleyball state from host/console
        if (volleyballHubConnection.State == HubConnectionState.Connected)
        {
            await volleyballHubConnection.SendAsync("RequestMatchState");
        }
    }

    private void UpdateTeamInMatches(List<MatchDto> matches, TeamDto updatedTeam)
    {
        foreach (var match in matches)
        {
            // Check and update Team 1 if non-null
            if (match.Team1 != null && (match.Team1.Id == updatedTeam.Id || match.Team1.Name == updatedTeam.Name))
            {
                match.Team1.Name = updatedTeam.Name;
                match.Team1.Logo = updatedTeam.Logo;
                match.Team1.Record = updatedTeam.Record;
            }

            // Check and update Team 2 if non-null
            if (match.Team2 != null && (match.Team2.Id == updatedTeam.Id || match.Team2.Name == updatedTeam.Name))
            {
                match.Team2.Name = updatedTeam.Name;
                match.Team2.Logo = updatedTeam.Logo;
                match.Team2.Record = updatedTeam.Record;
            }
        }
    }

    // 🖼️ Helper method for logo rendering
    private string GetImageSrc(byte[]? imageBytes)
    {
        if (imageBytes == null || imageBytes.Length == 0)
            return "images/default-logo.png";

        string base64 = Convert.ToBase64String(imageBytes);

        // 🔍 Read the first ~100 bytes to check for <svg tag anywhere near the header
        int headerLength = Math.Min(imageBytes.Length, 100);
        string headerText = System.Text.Encoding.UTF8.GetString(imageBytes, 0, headerLength);

        if (headerText.Contains("<svg", StringComparison.OrdinalIgnoreCase))
        {
            return $"data:image/svg+xml;base64,{base64}";
        }

        return $"data:image/png;base64,{base64}";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (shouldScrollToBottom)
        {
            shouldScrollToBottom = false;
            await ScrollToBottom();
        }
    }

    private void AddChatMessage(ChatMessageDto msg)
    {
        ChatMessages.Add(msg);

        if (ChatMessages.Count > MaxMessageLimit)
        {
            ChatMessages.RemoveRange(0, ChatMessages.Count - MaxMessageLimit);
        }

        shouldScrollToBottom = true;
    }

    private async Task ScrollToBottom()
    {
        try
        {
            await JS.InvokeVoidAsync("eval", "const container = document.getElementById('chat-messages-container'); if (container) { container.scrollTop = container.scrollHeight; }");
        }
        catch
        {
            // Fail silently
        }
    }

    private void SelectAvatar(string url)
    {
        SelectedAvatarUrl = url;
        showAvatarPicker = false;
    }

    private void ToggleAvatarPicker()
    {
        showAvatarPicker = !showAvatarPicker;
    }

    private async Task SendMessage()
    {
        if (!string.IsNullOrWhiteSpace(NewMessageText))
        {
            var text = NewMessageText;
            NewMessageText = string.Empty;

            var username = string.IsNullOrWhiteSpace(CurrentUsername) ? "Anonymous" : CurrentUsername.Trim();

            if (chatHubConnection is not null && chatHubConnection.State == HubConnectionState.Connected)
            {
                await chatHubConnection.SendAsync("SendChatMessage", username, text, SelectedAvatarUrl, DateTime.Now);
            }
            else
            {
                AddChatMessage(new ChatMessageDto
                {
                    Id = Guid.NewGuid(),
                    Username = username,
                    Message = text,
                    TimeStamp = DateTime.Now,
                    IsUser = true,
                    AvatarUrl = SelectedAvatarUrl
                });
            }
        }
    }

    private async Task HandleKeyUp(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SendMessage();
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/");
    }

    private void GoToBingo()
    {
        Navigation.NavigateTo("/bingo");
    }

    public async ValueTask DisposeAsync()
    {
        if (chatHubConnection is not null)
        {
            await chatHubConnection.DisposeAsync();
        }

        if (basketballHubConnection is not null)
        {
            await basketballHubConnection.DisposeAsync();
        }

        if (volleyballHubConnection is not null)
        {
            await volleyballHubConnection.DisposeAsync();
        }
    }
    
}