@page "/broadcast"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@implements IAsyncDisposable
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@using Microsoft.AspNetCore.SignalR.Client

<h3>Broadcaster Studio 🎙️🎥</h3>

<div class="mb-3">
    <button class="btn btn-primary me-2" @onclick="StartBroadcasting" disabled="@isBroadcasting">Start Broadcasting 🚀</button>
    <button class="btn btn-danger" @onclick="StopBroadcasting" disabled="@(!isBroadcasting)">Stop Broadcasting 🛑</button>
</div>

<div class="video-container mb-3">
    <h5>My Camera 📸</h5>
    <video id="localVideo" autoplay playsinline muted style="width: 500px; height: 375px; background: black; border-radius: 8px;"></video>
</div>

<div class="alert alert-dark">
    <strong>Live Status / Logs:</strong> @statusMessage
</div>

@code {
    private HubConnection? hubConnection;
    private DotNetObjectReference<WebcamBroadcast>? dotNetRef;
    private bool isBroadcasting = false;
    private string statusMessage = "Ready to broadcast.";

    protected override async Task OnInitializedAsync()
    {
        dotNetRef = DotNetObjectReference.Create(this);
        hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/chathub"))
            .Build();

        hubConnection.On<string, string, string>("ReceiveSignal", async (senderId, type, payload) =>
        {
            await JSRuntime.InvokeVoidAsync("handleSignalingData", senderId, type, payload);
        });

        await hubConnection.StartAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && dotNetRef != null)
        {
            await JSRuntime.InvokeVoidAsync("initWebRTC", dotNetRef);
        }
    }

    private async Task StartBroadcasting()
    {
        if (hubConnection != null)
        {
            isBroadcasting = true;
            statusMessage = "Broadcasting live! Waiting for viewers...";
            await JSRuntime.InvokeVoidAsync("startBroadcast", "Host");
        }
    }

    private async Task StopBroadcasting()
    {
        isBroadcasting = false;
        statusMessage = "Broadcast stopped. Ready to restart.";
        await JSRuntime.InvokeVoidAsync("stopBroadcast");

        if (hubConnection != null)
        {
            await hubConnection.SendAsync("BroadcastWebcamStopped");
        }
    }

    [JSInvokable]
    public async Task SendSignal(string targetConnectionId, string type, string payload)
    {
        if (hubConnection != null)
        {
            await hubConnection.SendAsync("SendSignal", targetConnectionId, type, payload);
        }
    }

    [JSInvokable]
    public async Task BroadcastWebcamStarted(string userName)
    {
        if (hubConnection != null)
        {
            await hubConnection.SendAsync("BroadcastWebcamStarted", userName);
        }
    }

    public async ValueTask DisposeAsync()
    {
        dotNetRef?.Dispose();
        await JSRuntime.InvokeVoidAsync("stopBroadcast");
        if (hubConnection != null)
        {
            await hubConnection.SendAsync("BroadcastWebcamStopped");
            await hubConnection.DisposeAsync();
        }
    }
}