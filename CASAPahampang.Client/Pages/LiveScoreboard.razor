@page "/scoreboard"

@using Microsoft.AspNetCore.SignalR.Client
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@using System.Text.Json
@implements IAsyncDisposable
@rendermode InteractiveWebAssembly
@inject NavigationManager Navigation

<div class="fan-scoreboard-container">
    <header class="scoreboard-header">
        <button class="btn-back" @onclick="GoBack" type="button">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg>
            Dashboard
        </button>

        <div class="tournament-title">
            <p class="branding-sub">CENTRAL AZUCARERA DE SAN ANTONIO</p>
            <h1>CASA PAHAMPANG BASKETBALL ⚡</h1>
            <p class="venue-tag">📍 Main Gymnasium • Court 1</p>
        </div>

        <div class="live-status-badge @(IsLive ? "is-live" : "is-paused")">
            <span class="status-dot"></span>
            @(IsLive ? "LIVE" : "PAUSED")
        </div>
    </header>

    <div class="arena-board">
        <div class="team-card team-home">
            <div class="team-meta">
                <img src="@Team1LogoUrl" alt="@Team1Name Logo" class="team-logo" />
                <h2 class="team-name">@Team1Name</h2>
                <div class="team-indicators">
                    @if (Team1Possession)
                    {
                        <span class="possession-pill">POSS ◄</span>
                    }
                    @if (Team1Fouls >= 5)
                    {
                        <span class="bonus-pill">BONUS</span>
                    }
                </div>
            </div>

            <div class="led-score-box">
                <span class="led-score">@Team1Score</span>
            </div>

            <div class="stats-row">
                <div class="stat-pill">
                    <span class="lbl">FOULS</span>
                    <span class="val">@Team1Fouls</span>
                </div>
                <div class="stat-pill">
                    <span class="lbl">TIMEOUTS</span>
                    <span class="val">@Team1Timeouts</span>
                </div>
            </div>
        </div>

        <div class="center-clock-panel">
            <div class="period-badge">
                <span>@PeriodText</span>
            </div>

            <div class="game-clock-card">
                <span class="clock-label">GAME CLOCK</span>
                <div class="led-digital-clock @(IsLive ? "running" : "stopped")">
                    @FormatTime(GameClockSeconds)
                </div>
            </div>

            <div class="shot-clock-card @(ShotClockSeconds <= 5 && ShotClockSeconds > 0 ? "critical" : "")">
                <span class="clock-label">SHOT CLOCK</span>
                <div class="led-shot-clock">
                    @ShotClockSeconds
                </div>
            </div>
        </div>

        <div class="team-card team-away">
            <div class="team-meta">
                <img src="@Team2LogoUrl" alt="@Team2Name Logo" class="team-logo" />
                <h2 class="team-name">@Team2Name</h2>
                <div class="team-indicators">
                    @if (Team2Possession)
                    {
                        <span class="possession-pill">► POSS</span>
                    }
                    @if (Team2Fouls >= 5)
                    {
                        <span class="bonus-pill">BONUS</span>
                    }
                </div>
            </div>

            <div class="led-score-box">
                <span class="led-score">@Team2Score</span>
            </div>

            <div class="stats-row">
                <div class="stat-pill">
                    <span class="lbl">FOULS</span>
                    <span class="val">@Team2Fouls</span>
                </div>
                <div class="stat-pill">
                    <span class="lbl">TIMEOUTS</span>
                    <span class="val">@Team2Timeouts</span>
                </div>
            </div>
        </div>
    </div>

    <div class="ticker-section">
        <div class="ticker-header">
            <span>🔥 RECENT PLAYS</span>
        </div>
        <div class="ticker-content">
            @if (RecentEvents.Count == 0)
            {
                <div class="ticker-item empty">Waiting for game actions...</div>
            }
            else
            {
                <div class="ticker-list">
                    @foreach (var evt in RecentEvents.Take(4))
                    {
                        <div class="ticker-item">
                            <span class="evt-time">Q@Period @FormatTime(evt.GameClock)</span>
                            <span class="evt-text">@evt.Message</span>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    public class PlayEvent
    {
        public int GameClock { get; set; }
        public string Message { get; set; } = string.Empty;
    }

    public class BasketballStatePayload
    {
        public string Team1Name { get; set; } = string.Empty;
        public string Team1LogoUrl { get; set; } = string.Empty;
        public int Team1Score { get; set; }
        public int Team1Fouls { get; set; }
        public int Team1Timeouts { get; set; }
        public bool Team1Possession { get; set; }

        public string Team2Name { get; set; } = string.Empty;
        public string Team2LogoUrl { get; set; } = string.Empty;
        public int Team2Score { get; set; }
        public int Team2Fouls { get; set; }
        public int Team2Timeouts { get; set; }
        public bool Team2Possession { get; set; }

        public int Period { get; set; }
        public string PeriodText { get; set; } = string.Empty;
        public int GameClockSeconds { get; set; }
        public int ShotClockSeconds { get; set; }
        public bool IsLive { get; set; }
        public List<PlayEvent> RecentEvents { get; set; } = new();
    }

    private HubConnection? hubConnection;

    private bool IsLive = false;

    private string Team1Name = "Tigers";
    private string Team1LogoUrl = "https://api.dicebear.com/7.x/identicon/svg?seed=Tigers";
    private int Team1Score = 0;
    private int Team1Fouls = 0;
    private int Team1Timeouts = 0;
    private bool Team1Possession = false;

    private string Team2Name = "Eagles";
    private string Team2LogoUrl = "https://api.dicebear.com/7.x/identicon/svg?seed=Eagles";
    private int Team2Score = 0;
    private int Team2Fouls = 0;
    private int Team2Timeouts = 0;
    private bool Team2Possession = false;

    private int Period = 1;
    private string PeriodText = "1ST QUARTER";

    private int GameClockSeconds = 600;
    private int ShotClockSeconds = 24;

    private List<PlayEvent> RecentEvents = new();

    protected override async Task OnInitializedAsync()
    {
        hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/basketballhub"))
            .WithAutomaticReconnect()
            .Build();

        hubConnection.On<string>("ReceiveBasketballState", (json) =>
        {
            var data = JsonSerializer.Deserialize<BasketballStatePayload>(json);
            if (data is not null)
            {
                Team1Name = data.Team1Name;
                Team1LogoUrl = data.Team1LogoUrl;
                Team1Score = data.Team1Score;
                Team1Fouls = data.Team1Fouls;
                Team1Timeouts = data.Team1Timeouts;
                Team1Possession = data.Team1Possession;

                Team2Name = data.Team2Name;
                Team2LogoUrl = data.Team2LogoUrl;
                Team2Score = data.Team2Score;
                Team2Fouls = data.Team2Fouls;
                Team2Timeouts = data.Team2Timeouts;
                Team2Possession = data.Team2Possession;

                Period = data.Period;
                PeriodText = data.PeriodText;
                GameClockSeconds = data.GameClockSeconds;
                ShotClockSeconds = data.ShotClockSeconds;
                IsLive = data.IsLive;
                RecentEvents = data.RecentEvents ?? new();

                InvokeAsync(StateHasChanged);
            }
        });

        await hubConnection.StartAsync();

        // Request initial state snapshot from active scorekeeper console ⚡
        await hubConnection.SendAsync("RequestBasketballState");
    }

    private string FormatTime(int totalSeconds)
    {
        int minutes = totalSeconds / 60;
        int seconds = totalSeconds % 60;
        return $"{minutes:D2}:{seconds:D2}";
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/dashboard");
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}