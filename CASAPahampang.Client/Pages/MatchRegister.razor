@page "/matches/register"
@using CASAPahampang.Client.Dtos
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Web
@inject HttpClient Http
@inject AuthService authService
@inject NavigationManager Nav

@* ⚡ Disable server prerendering so this page loads strictly in WebAssembly *@
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

<div class="container py-4" style="max-width: 800px;">
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-primary text-white py-3 px-4 rounded-top-3 d-flex align-items-center justify-content-between">
            <h4 class="card-title mb-0 fw-bold">
                🏆 Register New Match
            </h4>
            <span class="badge bg-white text-primary fw-semibold px-3 py-2">Admin Panel</span>
        </div>

        <div class="card-body p-4">
            @if (teams == null)
            {
                <div class="d-flex align-items-center justify-content-center py-5">
                    <div class="spinner-border text-primary me-3" role="status"></div>
                    <span class="fs-5 text-muted fw-semibold">Loading teams...</span>
                </div>
            }
            else
            {
                <EditForm Model="match" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger mb-3" />

                    <div class="row g-3 mb-3">
                        <div class="col-md-3">
                            <label class="form-label fw-bold">Game Number</label>
                            <InputNumber @bind-Value="match.GameNumber" class="form-control" placeholder="e.g. 1" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-bold">Sport Category</label>
                            <InputSelect @bind-Value="match.Sport" class="form-select">
                                <option value="Basketball">🏀 Basketball</option>
                                <option value="Volleyball">🏐 Volleyball</option>
                                <option value="Badminton">🏸 Badminton</option>
                                <option value="Chess">♟️ Chess</option>
                                <option value="Other">⚽ Other</option>
                            </InputSelect>
                        </div>

                        <div class="col-md-5">
                            <label class="form-label fw-bold">Venue</label>
                            <InputText @bind-Value="match.Venue" class="form-control" placeholder="e.g., Main Gym" />
                        </div>
                    </div>

                    <hr class="my-4 text-muted opacity-25" />

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Team 1</label>
                            <InputSelect @bind-Value="match.Team1Id" class="form-select">
                                <option value="@Guid.Empty">-- Select Team 1 --</option>
                                @foreach (var team in teams)
                                {
                                    <option value="@team.Id">@team.Name</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Team 2</label>
                            <InputSelect @bind-Value="match.Team2Id" class="form-select">
                                <option value="@Guid.Empty">-- Select Team 2 --</option>
                                @foreach (var team in teams)
                                {
                                    <option value="@team.Id" disabled="@(team.Id == match.Team1Id)">@team.Name</option>
                                }
                            </InputSelect>
                        </div>
                    </div>

                    <hr class="my-4 text-muted opacity-25" />

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Status Text</label>
                            <InputText @bind-Value="match.StatusText" class="form-control" placeholder="e.g., 8:00 PM PHT or Q4 02:45" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Period Details</label>
                            <InputText @bind-Value="match.PeriodDetails" class="form-control" placeholder="e.g., 4th Quarter or Set 3 (21-19)" />
                        </div>
                    </div>

                    <div class="form-check form-switch mb-4 p-3 bg-light rounded border">
                        <InputCheckbox @bind-Value="match.IsLive" class="form-check-input ms-0 me-2" id="isLive" />
                        <label class="form-check-label fw-bold text-dark" for="isLive">
                            Mark Match as Currently Live 🔴
                        </label>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-outline-secondary px-4" @onclick='() => Nav.NavigateTo("/")'>
                            Cancel
                        </button>
                        <button type="submit" class="btn btn-primary px-4 fw-bold" disabled="@isSubmitting">
                            @if (isSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                <span>Saving...</span>
                            }
                            else
                            {
                                <span>Save Match</span>
                            }
                        </button>
                    </div>
                </EditForm>
            }
        </div>
    </div>
</div>

@code {
    private MatchDto match = new();
    private List<TeamDto>? teams;
    private bool isSubmitting = false;

    protected override async Task OnInitializedAsync()
    {
        Console.WriteLine("=== [CLIENT DEBUG] OnInitializedAsync Started ===");

        if (!authService.IsInitialized)
            await authService.InitializeAsync();

        if (!authService.IsLoggedIn || !authService.Roles.Contains("Admin"))
        {
            Console.WriteLine("[CLIENT DEBUG] Access Denied -> Redirecting to /login");
            Nav.NavigateTo("login");
            return;
        }

        if (!string.IsNullOrEmpty(authService.AccessToken))
        {
            Http.DefaultRequestHeaders.Authorization = 
                new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", authService.AccessToken);
        }

        try
        {
            teams = await Http.GetFromJsonAsync<List<TeamDto>>("api/team") ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching teams: {ex.Message}");
        }
    }

    private async Task HandleSubmit()
    {
        if (match.Team1Id == Guid.Empty || match.Team2Id == Guid.Empty)
        {
            return;
        }

        isSubmitting = true;
        try
        {
            var response = await Http.PostAsJsonAsync("api/matches", match);
            if (response.IsSuccessStatusCode)
            {
                Nav.NavigateTo("/");
            }
        }
        finally
        {
            isSubmitting = false;
        }
    }
}