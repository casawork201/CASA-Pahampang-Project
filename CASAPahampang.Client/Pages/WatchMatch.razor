    } *@
    private async Task SendMessage()
    {
        if (!string.IsNullOrWhiteSpace(NewMessageText))
        {
            var text = NewMessageText;
            NewMessageText = string.Empty;

            var username = string.IsNullOrWhiteSpace(CurrentUsername) ? "Anonymous" : CurrentUsername.Trim();

            if (hubConnection is not null && hubConnection.State == HubConnectionState.Connected)
            {
                // 🚀 Call the distinct method name for the room-scoped chat!
                await hubConnection.SendAsync("SendRoomChatMessage", RoomName, username, text, SelectedAvatarUrl, DateTime.Now);
            }
            else
            {
                AddChatMessage(new ChatMessageDto
                {
                    Id = Guid.NewGuid(),
                    Username = username,
                    Message = text,
                    TimeStamp = DateTime.Now,
                    IsUser = true,
                    AvatarUrl = SelectedAvatarUrl
                });
            }
        }
    }

    private async Task HandleKeyUp(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SendMessage();
        }
    }
    private async Task TriggerFullscreen()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("toggleFullscreen", "videoContainer");
        }
        catch (JSException ex)
        {
            Console.WriteLine($"[Blazor] Fullscreen toggle failed: {ex.Message}");
        }
    }

    [JSInvokable]
    public async Task SendSignal(string targetConnectionId, string type, string payload)
    {
        if (hubConnection != null)
        {
            await hubConnection.SendAsync("SendSignal", targetConnectionId, type, payload);
        }
    }

    [JSInvokable]
    public async Task JoinRoom(string roomName)
    {
        if (hubConnection != null)
        {
            await hubConnection.SendAsync("JoinRoom", roomName);
        }
    }

    public async ValueTask DisposeAsync()
    {
        dotNetRef?.Dispose();
        await JSRuntime.InvokeVoidAsync("clearRemoteVideo");
        if (hubConnection != null)
        {
            await hubConnection.DisposeAsync();
        }
    }

    private class ChatMessageDto
    {
        public Guid Id { get; set; }
        public string Username { get; set; } = string.Empty;
        public string Message { get; set; } = string.Empty;
        public string AvatarUrl { get; set; } = string.Empty;
        public DateTime TimeStamp { get; set; }
        public bool IsUser { get; set; }
    }

    private class AvatarOptionDto
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Url { get; set; } = string.Empty;
    }
}