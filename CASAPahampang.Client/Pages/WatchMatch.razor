@page "/watch-match/mobile-legends"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@implements IAsyncDisposable
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@using Microsoft.AspNetCore.SignalR.Client

<PageTitle>MLBB Championship Arena | CASA Pahampang</PageTitle>


<div class="esport-body py-4">
    <div class="container-fluid px-4">
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card esport-card rounded-4 overflow-hidden p-4 h-100 d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <span class="badge esport-badge-live px-3 py-2 rounded-pill fw-bold mb-1">
                                <i class="bi bi-broadcast me-1"></i> LIVE ARENA 🟢
                            </span>
                            <h4 class="fw-bold text-dark mb-0 tracking-wide">Mobile Legends: Bang Bang Championship 🏆</h4>
                        </div>
                        <span class="badge esport-badge-room px-3 py-2 rounded-pill fw-semibold">
                            <i class="bi bi-controller me-1 text-success"></i> ROOM: @RoomName 🎮
                        </span>
                    </div>

                   <div class="video-wrapper bg-black rounded-4 overflow-hidden position-relative ratio ratio-16x9 mb-3 shadow-lg flex-grow-1 border border-light" id="videoContainer">
                        <video id="remoteVideo" autoplay playsinline controls style="display: @(isBroadcasting ? "block" : "none");" class="w-100 h-100 object-fit-cover"></video>

                        @if (isBroadcasting)
                        {
                            <button class="btn-fullscreen-fixed position-absolute bottom-0 end-0 m-3 btn btn-info btn-sm text-white rounded-pill px-3 py-2 shadow border-0 fw-bold z-3" @onclick="TriggerFullscreen">
                                <i class="bi bi-fullscreen me-1"></i> Fullscreen 📺
                            </button>
                        }

                        @if (!isBroadcasting)
                        {
                            <div class="standby-overlay d-flex flex-column align-items-center justify-content-center text-dark p-4 text-center bg-white bg-opacity-90">
                                <div class="spinner-border text-success mb-3" role="status" style="width: 3.5rem; height: 3.5rem;"></div>
                                <h4 class="fw-bold text-dark mb-2">⏳ STANDBY FOR MATCH START</h4>
                                <p class="text-muted mb-0 small">Broadcaster feed is connecting to the sky-blue arena... ☁️✨</p>
                            </div>
                        }
                    </div>

                    <div class="alert alert-light border border-success border-opacity-25 py-2 px-3 rounded-3 small fw-medium mb-0 text-dark bg-white shadow-sm">
                        <i class="bi bi-info-circle-fill text-success me-1"></i> <strong>Arena Status:</strong> @statusMessage
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card esport-card rounded-4 p-4 d-flex flex-column h-100" style="min-height: 520px;">
                    <div class="border-bottom border-success border-opacity-25 pb-2 mb-2 d-flex justify-content-between align-items-center">
                        <h5 class="fw-bold text-dark mb-0"><i class="bi bi-chat-square-quote-fill text-info me-2"></i> MLBB Arena Chat 💬</h5>
                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-2 py-1 small">
                            @OnlineFanCount Fans Online 🟢
                        </span>
                    </div>

                    <div class="chatbox-card">
                        <div class="chatbox-user-bar">
                            <div class="avatar-picker-wrapper">
                                <button type="button" class="btn-avatar-select" @onclick="ToggleAvatarPicker">
                                    <img src="@SelectedAvatarUrl" alt="Selected Avatar" class="current-avatar-preview" />
                                    <span class="change-lbl">Avatar ✏️</span>
                                </button>

                                @if (showAvatarPicker)
                                {
                                    <div class="avatar-grid-dropdown">
                                        <div class="avatar-grid-header">
                                            <span>Choose Avatar 🎨</span>
                                            <button type="button" class="btn-close-picker" @onclick="ToggleAvatarPicker">✕</button>
                                        </div>
                                        <div class="avatar-grid">
                                            @foreach (var avatar in AvatarList)
                                            {
                                                <div class="avatar-item @(SelectedAvatarUrl == avatar.Url ? "selected" : "")" 
                                                     @onclick="() => SelectAvatar(avatar.Url)">
                                                    <img src="@avatar.Url" alt="@avatar.Name" />
                                                    <span class="avatar-name">@avatar.Name</span>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>

                            <label for="username-input" class="username-label">Name:</label>
                            <input id="username-input" type="text" class="username-input" 
                                   @bind="CurrentUsername" @bind:event="oninput" placeholder="Enter handle..." />
                        </div>

                        <div id="chat-messages-container" class="chatbox-messages">
                            @if (ChatMessages.Count == 0)
                            {
                                <div class="text-center text-muted py-5 small my-auto">
                                    <i class="bi bi-chat-heart fs-2 d-block mb-2 text-success opacity-75"></i>
                                    Mobile Legends chat is ready. Drop a cheer to kick things off! 🎮💬✨
                                </div>
                            }
                            else
                            {
                                @foreach (var msg in ChatMessages)
                                {
                                    <div class="chat-message @(msg.IsUser ? "my-message" : "other-message")">
                                        <img src="@msg.AvatarUrl" alt="Avatar" class="chat-avatar" />
                                        <div class="msg-bubble">
                                            <div class="msg-header">
                                                <span class="msg-user">@msg.Username</span>
                                                <span class="msg-time">@msg.TimeStamp.ToString("hh:mm tt")</span>
                                            </div>
                                            <div class="msg-text">@msg.Message</div>
                                        </div>
                                    </div>
                                }
                            }
                        </div>

                        <div class="chatbox-footer">
                            <input type="text" class="chat-input" placeholder="Cheer for your team in Mobile Legends..." 
                                   @bind="NewMessageText" @bind:event="oninput" @onkeyup="HandleKeyUp" />
                            <button class="btn-send" @onclick="SendMessage" type="button">
                                <svg viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
                                </svg>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private HubConnection? hubConnection;
    private DotNetObjectReference<object>? dotNetRef;
    private string statusMessage = "Connected to Arena Hub. Waiting for match feed... 🎮";
    private bool isBroadcasting = false;
    private const string RoomName = "mobile-legends";

    private string NewMessageText = string.Empty;
    private string CurrentUsername = "Spectator_" + new Random().Next(1000, 9999);
    private int OnlineFanCount = 1;
    private bool shouldScrollToBottom = false;
    private const int MaxMessageLimit = 50;

    private string SelectedAvatarUrl = "https://api.dicebear.com/7.x/bottts/svg?seed=Panther";
    private bool showAvatarPicker = false;

    private List<AvatarOptionDto> AvatarList = new()
    {
        new AvatarOptionDto { Id = Guid.NewGuid(), Name = "Panther", Url = "https://api.dicebear.com/7.x/bottts/svg?seed=Panther" },
        new AvatarOptionDto { Id = Guid.NewGuid(), Name = "Eagle", Url = "https://api.dicebear.com/7.x/bottts/svg?seed=Eagle" },
        new AvatarOptionDto { Id = Guid.NewGuid(), Name = "Tiger", Url = "https://api.dicebear.com/7.x/bottts/svg?seed=Tiger" },
        new AvatarOptionDto { Id = Guid.NewGuid(), Name = "Spiker", Url = "https://api.dicebear.com/7.x/bottts/svg?seed=Spiker" },
        new AvatarOptionDto { Id = Guid.NewGuid(), Name = "Falcon", Url = "https://api.dicebear.com/7.x/bottts/svg?seed=Falcon" },
        new AvatarOptionDto { Id = Guid.NewGuid(), Name = "Blaze", Url = "https://api.dicebear.com/7.x/bottts/svg?seed=Blaze" },
        new AvatarOptionDto { Id = Guid.NewGuid(), Name = "Knight", Url = "https://api.dicebear.com/7.x/bottts/svg?seed=Knight" },
        new AvatarOptionDto { Id = Guid.NewGuid(), Name = "Rocket", Url = "https://api.dicebear.com/7.x/bottts/svg?seed=Rocket" }
    };

    private List<ChatMessageDto> ChatMessages = new();

    protected override async Task OnInitializedAsync()
    {
        dotNetRef = DotNetObjectReference.Create<object>(this);
        hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/chathub"))
            .WithAutomaticReconnect()
            .Build();

        hubConnection.On<string, string>("WebcamStarted", async (broadcasterId, user) =>
        {
            isBroadcasting = true;
            statusMessage = "Broadcaster detected! Linking video stream... 🚀";
            StateHasChanged();

            await JSRuntime.InvokeVoidAsync("connectToBroadcaster", broadcasterId);
        });

        hubConnection.On<string>("WebcamStopped", async (broadcasterId) =>
        {
            isBroadcasting = false;
            statusMessage = "Match broadcast ended. Standing by for next round... ⏳";
            StateHasChanged();

            await JSRuntime.InvokeVoidAsync("clearRemoteVideo");
        });

        hubConnection.On<string, string, string>("ReceiveSignal", async (senderId, type, payload) =>
        {
            await JSRuntime.InvokeVoidAsync("handleSignalingData", senderId, type, payload);
        });

        hubConnection.On<string, string, string, DateTime>("ReceiveChatMessage", async (user, message, avatarUrl, timestamp) =>
        {
            bool isMe = string.Equals(user, CurrentUsername, StringComparison.OrdinalIgnoreCase);

            AddChatMessage(new ChatMessageDto
            {
                Id = Guid.NewGuid(),
                Username = user,
                Message = message,
                AvatarUrl = avatarUrl,
                TimeStamp = timestamp,
                IsUser = isMe
            });

            await InvokeAsync(StateHasChanged);
        });

        hubConnection.On<int>("UpdateOnlineCount", async (count) =>
        {
            OnlineFanCount = count;
            await InvokeAsync(StateHasChanged);
        });

        await hubConnection.StartAsync();
        await hubConnection.SendAsync("JoinRoom", RoomName);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && dotNetRef != null)
        {
            await JSRuntime.InvokeVoidAsync("initWebRTC", dotNetRef);
            await JSRuntime.InvokeVoidAsync("joinGameRoom", RoomName);
        }

        if (shouldScrollToBottom)
        {
            shouldScrollToBottom = false;
            await ScrollToBottom();
        }
    }

    private void AddChatMessage(ChatMessageDto msg)
    {
        ChatMessages.Add(msg);

        if (ChatMessages.Count > MaxMessageLimit)
        {
            ChatMessages.RemoveRange(0, ChatMessages.Count - MaxMessageLimit);
        }

        shouldScrollToBottom = true;
    }

    private async Task ScrollToBottom()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("eval", "const container = document.getElementById('chat-messages-container'); if (container) { container.scrollTop = container.scrollHeight; }");
        }
        catch
        {
            // Fail silently
        }
    }

    private void SelectAvatar(string url)
    {
        SelectedAvatarUrl = url;
        showAvatarPicker = false;
    }

    private void ToggleAvatarPicker()
    {
        showAvatarPicker = !showAvatarPicker;
    }

    @* private async Task SendMessage()
    {
        if (!string.IsNullOrWhiteSpace(NewMessageText))
        {
            var text = NewMessageText;
            NewMessageText = string.Empty;

            var username = string.IsNullOrWhiteSpace(CurrentUsername) ? "Anonymous" : CurrentUsername.Trim();

            if (hubConnection is not null && hubConnection.State == HubConnectionState.Connected)
            {
                await hubConnection.SendAsync("SendChatMessage", username, text, SelectedAvatarUrl, DateTime.Now);
            }
            else
            {
                AddChatMessage(new ChatMessageDto
                {
                    Id = Guid.NewGuid(),
