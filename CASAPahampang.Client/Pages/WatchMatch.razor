@page "/watch-match/mobile-legends"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@implements IAsyncDisposable
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@using Microsoft.AspNetCore.SignalR.Client

<PageTitle>MLBB Championship Arena | CASA Pahampang</PageTitle>

<div class="esport-body py-4">
    <div class="container-fluid px-4">
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card esport-card rounded-4 overflow-hidden p-4 h-100 d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <span class="badge esport-badge-live px-3 py-2 rounded-pill fw-bold mb-1">
                                <i class="bi bi-broadcast me-1"></i> LIVE ARENA 🟢
                            </span>
                            <h4 class="fw-bold text-dark mb-0 tracking-wide">Mobile Legends: Bang Bang Championship 🏆</h4>
                        </div>
                        <span class="badge esport-badge-room px-3 py-2 rounded-pill fw-semibold">
                            <i class="bi bi-controller me-1 text-success"></i> TOURNAMENT ROOM 🎮
                        </span>
                    </div>

                    <div class="video-wrapper bg-black rounded-4 overflow-hidden position-relative ratio ratio-16x9 mb-3 shadow-lg flex-grow-1 border border-light" id="videoContainer">
                        <video id="remoteVideo" autoplay playsinline controls style="display: @(isBroadcasting ? "block" : "none");" class="w-100 h-100 object-fit-cover"></video>
                        
                        @if (isBroadcasting)
                        {
                            <button class="position-absolute bottom-0 end-0 m-3 btn btn-info btn-sm text-white rounded-pill px-3 py-2 shadow border-0 fw-bold z-3" @onclick="TriggerFullscreen">
                                <i class="bi bi-fullscreen me-1"></i> Fullscreen 📺
                            </button>
                        }
                        
                        @if (!isBroadcasting)
                        {
                            <div class="standby-overlay d-flex flex-column align-items-center justify-content-center text-dark p-4 text-center bg-white bg-opacity-90">
                                <div class="spinner-border text-success mb-3" role="status" style="width: 3.5rem; height: 3.5rem;"></div>
                                <h4 class="fw-bold text-dark mb-2">⏳ STANDBY FOR MATCH START</h4>
                                <p class="text-muted mb-0 small">Broadcaster feed is connecting to the sky-blue arena... ☁️✨</p>
                            </div>
                        }
                    </div>

                    <div class="alert alert-light border border-success border-opacity-25 py-2 px-3 rounded-3 small fw-medium mb-0 text-dark bg-white shadow-sm">
                        <i class="bi bi-info-circle-fill text-success me-1"></i> <strong>Arena Status:</strong> @statusMessage
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card esport-card rounded-4 p-4 d-flex flex-column h-100" style="min-height: 520px;">
                    <div class="border-bottom border-success border-opacity-25 pb-3 mb-3">
                        <h5 class="fw-bold text-dark mb-0"><i class="bi bi-chat-square-quote-fill text-info me-2"></i> Live Arena Chat 💬</h5>
                        <p class="text-muted small mb-0">Cheer for your team with global spectators! 🌟</p>
                    </div>

                    <div class="chat-messages flex-grow-1 overflow-auto pe-2 mb-3" style="max-height: 420px; min-height: 320px;">
                        @if (_messages.Count == 0)
                        {
                            <div class="text-center text-muted py-5 small">
                                <i class="bi bi-chat-heart fs-2 d-block mb-2 text-success opacity-75"></i>
                                Arena chat is ready. Drop a message to kick things off! 🌿💬
                            </div>
                        }
                        else
                        {
                            @foreach (var msg in _messages)
                            {
                                <div class="mb-2 p-2.5 rounded-3 chat-bubble text-dark small shadow-sm">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <strong class="text-success fw-bold">@msg.User</strong>
                                        <span class="text-muted" style="font-size: 0.7rem;">@msg.Timestamp</span>
                                    </div>
                                    <div class="text-secondary text-break" style="font-size: 0.9rem;">@msg.Text</div>
                                </div>
                            }
                        }
                    </div>

                    <div class="input-group">
                        <input type="text" class="form-control esport-input py-2 shadow-none" placeholder="Cheer or chat..." @bind="_newMessage" @onkeyup="HandleKeyup" />
                        <button class="btn btn-green-glow px-3 rounded-end fw-bold" @onclick="SendMessage">
                            <i class="bi bi-send-fill"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private HubConnection? hubConnection;
    private DotNetObjectReference<object>? dotNetRef;
    private string statusMessage = "Connected to Arena Hub. Waiting for match feed... 🎮";
    private bool isBroadcasting = false;
    private const string RoomName = "mobile-legends";

    private string _newMessage = string.Empty;
    private string _username = "Spectator_" + new Random().Next(1000, 9999);
    private List<ChatMessage> _messages = new();

    protected override async Task OnInitializedAsync()
    {
        dotNetRef = DotNetObjectReference.Create<object>(this);
        hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/chathub"))
            .Build();

        hubConnection.On<string, string>("WebcamStarted", async (broadcasterId, user) =>
        {
            isBroadcasting = true;
            statusMessage = "Broadcaster detected! Linking video stream... 🚀";
            StateHasChanged();

            await JSRuntime.InvokeVoidAsync("connectToBroadcaster", broadcasterId);
        });

        hubConnection.On<string>("WebcamStopped", async (broadcasterId) =>
        {
            isBroadcasting = false;
            statusMessage = "Match broadcast ended. Standing by for next round... ⏳";
            StateHasChanged();

            await JSRuntime.InvokeVoidAsync("clearRemoteVideo");
        });

        hubConnection.On<string, string, string>("ReceiveSignal", async (senderId, type, payload) =>
        {
            await JSRuntime.InvokeVoidAsync("handleSignalingData", senderId, type, payload);
        });

        hubConnection.On<string, string>("ReceiveMessage", (user, message) =>
        {
            _messages.Add(new ChatMessage
            {
                User = user,
                Text = message,
                Timestamp = DateTime.Now.ToString("hh:mm tt")
            });
            StateHasChanged();
        });

        await hubConnection.StartAsync();
        await hubConnection.SendAsync("JoinRoom", RoomName);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && dotNetRef != null)
        {
            await JSRuntime.InvokeVoidAsync("initWebRTC", dotNetRef);
            await JSRuntime.InvokeVoidAsync("joinGameRoom", RoomName);
        }
    }

    private async Task SendMessage()
    {
        if (!string.IsNullOrWhiteSpace(_newMessage) && hubConnection != null)
        {
            await hubConnection.SendAsync("SendMessage", RoomName, _username, _newMessage);
            _newMessage = string.Empty;
        }
    }

    private async Task HandleKeyup(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SendMessage();
        }
    }

    private async Task TriggerFullscreen()
    {
        await JSRuntime.InvokeVoidAsync("toggleFullscreen", "videoContainer");
    }

    [JSInvokable]
    public async Task SendSignal(string targetConnectionId, string type, string payload)
    {
        if (hubConnection != null)
        {
            await hubConnection.SendAsync("SendSignal", targetConnectionId, type, payload);
        }
    }

    [JSInvokable]
    public async Task JoinRoom(string roomName)
    {
        if (hubConnection != null)
        {
            await hubConnection.SendAsync("JoinRoom", roomName);
        }
    }

    public async ValueTask DisposeAsync()
    {
        dotNetRef?.Dispose();
        await JSRuntime.InvokeVoidAsync("clearRemoteVideo");
        if (hubConnection != null)
        {
            await hubConnection.DisposeAsync();
        }
    }

    private class ChatMessage
    {
        public string User { get; set; } = string.Empty;
        public string Text { get; set; } = string.Empty;
        public string Timestamp { get; set; } = string.Empty;
    }
}