@using TestWASM.AuthLib.Services
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@inject AuthService AuthService
@inject NavigationManager Nav
@implements IDisposable

@if (!AuthService.IsLoggedIn)
{
    <a class="nav-link px-3 py-2 rounded" href="login">
        <span class="bi bi-box-arrow-in-right me-1"></span> Login
    </a>
}
else
{
    <div class="user-menu @(isOpen ? "open" : "")">
        <button type="button" class="user-menu-trigger" @onclick="ToggleMenu">
            <span class="user-avatar">@GetInitial()</span>
            <span class="bi bi-chevron-down chevron"></span>
        </button>

        @if (isOpen)
        {
            <div class="user-menu-dropdown">
                <div class="user-menu-header">
                    <span class="user-avatar user-avatar-lg">@GetInitial()</span>
                    <div class="user-menu-email" title="@AuthService.Email">@AuthService.Email</div>
                </div>
                <hr class="user-menu-divider" />
                <button type="button" class="user-menu-item logout-item" @onclick="Logout">
                    <span class="bi bi-box-arrow-right me-2"></span> Logout
                </button>
            </div>
        }
    </div>
}

@code {
    private bool isOpen;

    protected override void OnInitialized()
    {
        AuthService.OnChange += StateHasChanged;
    }

    private void ToggleMenu() => isOpen = !isOpen;

    private async Task Logout()
    {
        isOpen = false;
        await AuthService.LogoutAsync();
        Nav.NavigateTo("/", forceLoad: true);
    }

    private string GetInitial()
    {
        var email = AuthService.Email;
        return string.IsNullOrEmpty(email) ? "?" : email[0].ToString().ToUpper();
    }

    public void Dispose()
    {
        AuthService.OnChange -= StateHasChanged;
    }
}

<style>
    .user-menu {
        position: relative;
        display: inline-block;
    }

    .user-menu-trigger {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        background: transparent;
        border: none;
        padding: 0.3rem 0.5rem;
        border-radius: 999px;
        cursor: pointer;
        transition: background-color 0.15s ease;
    }

    .user-menu-trigger:hover,
    .user-menu.open .user-menu-trigger {
        background-color: rgba(255, 255, 255, 0.08);
    }

    .user-avatar {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 30px;
        height: 30px;
        min-width: 30px;
        border-radius: 50%;
        background: linear-gradient(135deg, #11998e, #38ef7d);
        color: #fff;
        font-weight: 700;
        font-size: 0.8rem;
        text-transform: uppercase;
    }

    .chevron {
        font-size: 0.65rem;
        color: #cbd5e1;
        transition: transform 0.15s ease;
    }

    .user-menu.open .chevron {
        transform: rotate(180deg);
    }

    .user-menu-dropdown {
        position: absolute;
        top: calc(100% + 8px);
        right: 0;
        min-width: 220px;
        background: #0f172a;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.4);
        padding: 0.75rem;
        z-index: 1050;
        animation: dropdownFadeIn 0.15s ease-out;
    }

    @@keyframes dropdownFadeIn {
        from { opacity: 0; transform: translateY(-6px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .user-menu-header {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.25rem 0.25rem 0.5rem 0.25rem;
    }

    .user-avatar-lg {
        width: 36px;
        height: 36px;
        min-width: 36px;
        font-size: 0.9rem;
    }

    .user-menu-email {
        font-size: 0.85rem;
        color: #e2e8f0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .user-menu-divider {
        border-color: rgba(255, 255, 255, 0.1);
        margin: 0.4rem 0;
    }

    .user-menu-item {
        display: flex;
        align-items: center;
        width: 100%;
        background: transparent;
        border: none;
        color: #cbd5e1;
        font-size: 0.85rem;
        font-weight: 600;
        padding: 0.5rem 0.6rem;
        border-radius: 8px;
        cursor: pointer;
        transition: background-color 0.15s ease, color 0.15s ease;
    }

    .logout-item:hover {
        background-color: rgba(255, 107, 107, 0.12);
        color: #ff6b6b;
    }
</style>