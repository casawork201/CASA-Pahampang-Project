@using Microsoft.AspNetCore.Antiforgery
@inject IAntiforgery Antiforgery
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["CASAPahampang.styles.css"]" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <script src="js/webrtc.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @{
        // Dito natin kukunin ang token gamit ang context ng kasalukuyang request
        var tokens = Antiforgery.GetAndStoreTokens(HttpContext);
    }
    <input type="hidden" id="antiforgery-token" value="@tokens.RequestToken" />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script>
        window.PostToSignIn = async function(payload){
            console.log("[ERP_Processor] initializing secure handshake...");
            try{
                document.body.style.cursor = "wait";

                const getAntiforgeryToken = () => {
                    const tokenElement = document.getElementById("antiforgery-token");
                    return tokenElement ? tokenElement.value : "";
                };

                const token = getAntiforgeryToken();
                
                if (!token) {
                    throw new Error("Antiforgery token not found in DOM.");
                }

                const form = document.createElement("form");
                form.method = "POST";
                form.action = "/blazor/signin";

                for(const key in payload){
                    if(payload.hasOwnProperty(key)){
                        const input = document.createElement("input");
                        input.type = "hidden";
                        input.name = key;
                        input.value = payload[key];
                        form.appendChild(input);
                    }
                }

                const antiInput = document.createElement("input");
                antiInput.type = "hidden";
                antiInput.name = "__RequestVerificationToken";
                antiInput.value = token;
                form.appendChild(antiInput);

                document.body.appendChild(form);
                form.submit();
            }
            catch(err){
                console.error("Handshake Failure:", err);
                document.body.style.cursor = "default";
                alert("Comm-link failed: " + err.message);
            }
        }
    </script>
    <script>
        window.bingoAudio = {
            selectedVoiceIndex: -1,

            // Fetch only English-language browser voices
            getVoices: function () {
                if (!('speechSynthesis' in window)) return [];
                let voices = window.speechSynthesis.getVoices();
                
                // Filter strictly for voices starting with 'en' (English)
                return voices
                    .map((v, i) => ({ index: i, name: v.name, lang: v.lang }))
                    .filter(v => v.lang.toLowerCase().startsWith('en'))
                    .map(v => ({
                        index: v.index,
                        name: `${v.name} (${v.lang})`
                    }));
            },

            // Set active voice by its system index
            setVoice: function (index) {
                this.selectedVoiceIndex = parseInt(index);
            },

            // Announce letter and number clearly
            announce: function (text) {
                if (!('speechSynthesis' in window)) return;

                // Clear queued audio to prevent overlapping speech threads
                window.speechSynthesis.cancel();

                setTimeout(() => {
                    let utterance = new SpeechSynthesisUtterance(text);
                    utterance.rate = 0.9;   // Pacing for maximum caller clarity 📢
                    utterance.pitch = 1.0;
                    utterance.volume = 1.0;

                    let voices = window.speechSynthesis.getVoices();
                    if (voices.length > 0) {
                        // Find chosen voice or default to the first available English voice
                        let chosenVoice = voices[this.selectedVoiceIndex];
                        if (!chosenVoice || !chosenVoice.lang.toLowerCase().startsWith('en')) {
                            chosenVoice = voices.find(v => v.lang.toLowerCase().startsWith('en')) || voices[0];
                        }
                        utterance.voice = chosenVoice;
                    }

                    window.speechSynthesis.speak(utterance);
                }, 50);
            },

            stop: function () {
                if ('speechSynthesis' in window) {
                    window.speechSynthesis.cancel();
                }
            }
        };
    </script>
    <script>
        window.bingoSync = {
            channel: new BroadcastChannel('bingo_game_sync'),

            // Called by Caller page to broadcast updates
            broadcast: function (stateJson) {
                this.channel.postMessage(stateJson);
            },

            // Called by Display page to listen for updates
            listen: function (dotnetRef) {
                this.channel.onmessage = (event) => {
                    dotnetRef.invokeMethodAsync('UpdateGameState', event.data);
                };
            }
        };
    </script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;
}