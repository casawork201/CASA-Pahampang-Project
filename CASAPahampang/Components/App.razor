@using Microsoft.AspNetCore.Antiforgery
@inject IAntiforgery Antiforgery
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["CASAPahampang.styles.css"]" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <script src="js/webrtc.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @{
        // Dito natin kukunin ang token gamit ang context ng kasalukuyang request
        var tokens = Antiforgery.GetAndStoreTokens(HttpContext);
    }
    <input type="hidden" id="antiforgery-token" value="@tokens.RequestToken" />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script>
        window.PostToSignIn = async function(payload){
            console.log("[ERP_Processor] initializing secure handshake...");
            try{
                document.body.style.cursor = "wait";

                const getAntiforgeryToken = () => {
                    const tokenElement = document.getElementById("antiforgery-token");
                    return tokenElement ? tokenElement.value : "";
                };

                const token = getAntiforgeryToken();
                
                if (!token) {
                    throw new Error("Antiforgery token not found in DOM.");
                }

                const form = document.createElement("form");
                form.method = "POST";
                form.action = "/blazor/signin";

                for(const key in payload){
                    if(payload.hasOwnProperty(key)){
                        const input = document.createElement("input");
                        input.type = "hidden";
                        input.name = key;
                        input.value = payload[key];
                        form.appendChild(input);
                    }
                }

                const antiInput = document.createElement("input");
                antiInput.type = "hidden";
                antiInput.name = "__RequestVerificationToken";
                antiInput.value = token;
                form.appendChild(antiInput);

                document.body.appendChild(form);
                form.submit();
            }
            catch(err){
                console.error("Handshake Failure:", err);
                document.body.style.cursor = "default";
                alert("Comm-link failed: " + err.message);
            }
        }
    </script>
    <script>
        window.bingoAudio = {
            selectedVoiceIndex: -1,
            voicesLoaded: false,

            // Initialize and listen for asynchronous voice loading
            init: function () {
                if (!('speechSynthesis' in window)) return;
                
                const loadVoices = () => {
                    let voices = window.speechSynthesis.getVoices();
                    if (voices.length > 0) {
                        this.voicesLoaded = true;
                    }
                };

                loadVoices();
                if (window.speechSynthesis.onvoiceschanged !== undefined) {
                    window.speechSynthesis.onvoiceschanged = loadVoices;
                }
            },

            announce: function (text) {
                if (!('speechSynthesis' in window)) {
                    console.error("Speech Synthesis API is not supported in this browser.");
                    return;
                }

                // Clear any overlapping speech threads
                window.speechSynthesis.cancel();

                setTimeout(() => {
                    let utterance = new SpeechSynthesisUtterance(text);
                    utterance.rate = 0.9;   // Pacing for caller clarity 📢
                    utterance.pitch = 1.0;
                    utterance.volume = 1.0;

                    let voices = window.speechSynthesis.getVoices();
                    if (voices && voices.length > 0) {
                        let chosenVoice = voices[this.selectedVoiceIndex];
                        if (!chosenVoice) {
                            chosenVoice = voices.find(v => v.lang.toLowerCase().startsWith('en')) || voices[0];
                        }
                        if (chosenVoice) {
                            utterance.voice = chosenVoice;
                        }
                    }

                    // Speak regardless—if the array is empty, the browser will use its default voice fallback
                    window.speechSynthesis.speak(utterance);
                }, 50);
            },

            stop: function () {
                if ('speechSynthesis' in window) {
                    window.speechSynthesis.cancel();
                }
            }
        };

        // Kick off voice loading immediately
        window.bingoAudio.init();
    </script>
    <script>
        window.bingoSync = {
            channel: new BroadcastChannel('bingo_game_sync'),

            // Called by Caller page to broadcast updates
            broadcast: function (stateJson) {
                this.channel.postMessage(stateJson);
            },

            // Called by Display page to listen for updates
            listen: function (dotnetRef) {
                this.channel.onmessage = (event) => {
                    dotnetRef.invokeMethodAsync('UpdateGameState', event.data);
                };
            }
        };
    </script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;
}