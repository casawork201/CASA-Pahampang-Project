@page "/"
@inject NavigationManager Navigation

<div class="landing-container">
    <div class="bg-collage">
        <div class="bg-overlay"></div>
        
        <div class="video-grid">
            <video autoplay loop muted playsinline class="bg-video video-1">
                <source src="videos/basketball.mp4" type="video/mp4" />
            </video>
            <video autoplay loop muted playsinline class="bg-video video-2">
                <source src="videos/volleyball.mp4" type="video/mp4" />
            </video>
            <video autoplay loop muted playsinline class="bg-video video-3">
                <source src="videos/taekwondo.mp4" type="video/mp4" />
            </video>
            <video autoplay loop muted playsinline class="bg-video video-4">
                <source src="videos/olympic.mp4" type="video/mp4" />
            </video>
            <video autoplay loop muted playsinline class="bg-video video-5">
                <source src="videos/tennis.mp4" type="video/mp4" />
            </video>
            <video autoplay loop muted playsinline class="bg-video video-6">
                <source src="videos/football.mp4" type="video/mp4" />
            </video>  
            <video autoplay loop muted playsinline class="bg-video video-7">
                <source src="videos/mobile.mp4" type="video/mp4" />
            </video>            
        </div>
    </div>

    <div class="content-wrapper">
        <header class="header-branding">
            <p class="subtitle">CENTRAL AZUCARERA DE SAN ANTONIO</p>
            <h1 class="main-title">CASA PAHAMPANG <img src="icons/casa_icon.ico" alt="Logo" class="brand-logo" style="width: 48px; height: 48px; object-fit: contain;" /></h1>
            <div class="accent-line"></div>
        </header>

        <footer class="action-footer">
            <a class="btn-lets-play" href="/dashboard">
                <span>LET'S PLAY</span>
                <svg class="play-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M8 5v14l11-7z"/>
                </svg>
            </a>
        </footer>
    </div>
</div>
